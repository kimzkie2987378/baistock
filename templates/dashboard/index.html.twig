{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Dashboard - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- WELCOME BANNER & DATE/TIME -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#6D28D9] to-[#8B5CF6] text-white flex items-center justify-center shadow-lg shadow-purple-500/20 flex-shrink-0">
                <i data-lucide="store" class="w-6 h-6"></i>
            </div>
            <div>
                <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">
                    Welcome back, {{ app.user ? (app.user.fullName ?: app.user.userIdentifier) : 'Admin' }}!
                </h1>
                <p class="text-slate-500 text-sm">Here's what's happening with your store today.</p>
            </div>
        </div>

        <!-- Date & Live Time indicator matching mockup -->
        <div class="flex items-center gap-3 bg-white px-4 py-2.5 rounded-2xl border border-slate-200/80 shadow-sm self-start md:self-auto">
            <div class="p-2 bg-purple-50 text-[#7C3AED] rounded-xl">
                <i data-lucide="calendar" class="w-5 h-5"></i>
            </div>
            <div class="text-right">
                <div id="live-date" class="text-xs font-semibold text-slate-700">September 29, 2026</div>
                <div id="live-time" class="text-xs text-slate-400 font-mono font-medium">10:24 AM</div>
            </div>
        </div>
    </div>

    <!-- TOP 4 METRIC STAT CARDS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        <!-- Card 1: Total Products -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-purple-50 text-[#7C3AED] flex items-center justify-center">
                    <i data-lucide="package" class="w-5 h-5"></i>
                </div>
                <span class="inline-flex items-center text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full">
                    ↗ +2 this week
                </span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Products</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1 font-display">
                {{ total_products }}
            </div>
        </div>

        <!-- Card 2: Total Stock (Units) -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                    <i data-lucide="database" class="w-5 h-5"></i>
                </div>
                <span class="inline-flex items-center text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full">
                    ↗ +56 this week
                </span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Stock (Units)</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1 font-display">
                {{ total_stock_units|number_format(0, '.', ',') }}
            </div>
        </div>

        <!-- Card 3: Low Stock Items -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-rose-50 text-rose-500 flex items-center justify-center">
                    <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                </div>
                <span class="inline-flex items-center text-[11px] font-semibold text-rose-600 bg-rose-50 px-2.5 py-0.5 rounded-full">
                    ↗ +2 this week
                </span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Low Stock Items</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1 font-display">
                {{ low_stock_count }}
            </div>
        </div>

        <!-- Card 4: Total Sales -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/70 shadow-sm hover:shadow-md transition-shadow">
            <div class="flex items-center justify-between mb-3">
                <div class="w-11 h-11 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                    <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                </div>
                <span class="inline-flex items-center text-[11px] font-semibold text-emerald-600 bg-emerald-50 px-2.5 py-0.5 rounded-full">
                    ₱ {{ today_sales|number_format(2, '.', ',') }} today
                </span>
            </div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Sales</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1 font-display text-slate-900">
                ₱ {{ total_sales|number_format(2, '.', ',') }}
            </div>
        </div>
    </div>

    <!-- MIDDLE ROW: Sales Overview Chart & Low Stock Alert -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Sales Overview Chart Card (7 cols) -->
        <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200/70 shadow-sm flex flex-col justify-between">
            <div class="flex items-center justify-between mb-6">
                <div class="flex items-center gap-2.5">
                    <div class="p-1.5 bg-purple-100 text-[#7C3AED] rounded-lg">
                        <i data-lucide="bar-chart-2" class="w-4 h-4"></i>
                    </div>
                    <h2 class="text-base font-bold text-slate-800 font-display">Sales Overview</h2>
                </div>

                <!-- Daily / Weekly / Monthly Pills -->
                <div class="flex items-center bg-slate-100 p-1 rounded-xl text-xs font-medium text-slate-600">
                    <button type="button" id="tab-daily" onclick="switchChartMode('daily')" class="px-3 py-1.5 rounded-lg bg-[#7C3AED] text-white shadow-sm font-semibold transition-all">Daily</button>
                    <button type="button" id="tab-weekly" onclick="switchChartMode('weekly')" class="px-3 py-1.5 rounded-lg hover:text-slate-900 transition-all">Weekly</button>
                    <button type="button" id="tab-monthly" onclick="switchChartMode('monthly')" class="px-3 py-1.5 rounded-lg hover:text-slate-900 transition-all">Monthly</button>
                </div>
            </div>

            <!-- Bar Chart Canvas -->
            <div class="relative w-full h-64">
                <canvas id="salesOverviewChart"></canvas>
            </div>
        </div>

        <!-- Low Stock Alert Card (5 cols) -->
        <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/70 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-4">
                    <div class="flex items-center gap-2.5">
                        <div class="p-1.5 bg-rose-100 text-rose-600 rounded-lg">
                            <i data-lucide="alert-triangle" class="w-4 h-4"></i>
                        </div>
                        <h2 class="text-base font-bold text-slate-800 font-display">Low Stock Alert</h2>
                    </div>
                    <a href="{{ path('app_product_index', {'stock': 'low'}) }}" class="text-xs font-semibold text-purple-600 hover:text-purple-700">
                        View All
                    </a>
                </div>

                <!-- Low stock list table -->
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-xs">
                        <thead>
                            <tr class="text-slate-400 font-semibold border-b border-slate-100">
                                <th class="pb-3 font-medium">Product</th>
                                <th class="pb-3 font-medium text-center">Current Stock</th>
                                <th class="pb-3 font-medium text-right">Minimum Stock</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-50">
                            {% for p in low_stock_products %}
                                <tr class="hover:bg-slate-50/70 transition-colors">
                                    <td class="py-3">
                                        <div class="flex items-center gap-3">
                                            <div class="w-9 h-9 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center p-0.5 flex-shrink-0 overflow-hidden shadow-sm">
                                                {% if p.imagePath %}
                                                    <img src="{{ asset('uploads/products/' ~ p.imagePath) }}" alt="{{ p.name }}" class="w-full h-full object-cover rounded-lg">
                                                {% elseif p.category == 'Snacks' %}
                                                    <span class="text-base">🍿</span>
                                                {% elseif p.category == 'Fruits' %}
                                                    <span class="text-base">🍎</span>
                                                {% elseif p.category == 'Canned Goods' %}
                                                    <span class="text-base">🥫</span>
                                                {% elseif p.category == 'Vegetables' %}
                                                    <span class="text-base">🥕</span>
                                                {% elseif p.category == 'Groceries' %}
                                                    <span class="text-base">🛒</span>
                                                {% else %}
                                                    <span class="text-base">📦</span>
                                                {% endif %}
                                            </div>
                                            <div>
                                                <a href="{{ path('app_product_edit', {'id': p.id}) }}" class="font-semibold text-slate-800 hover:text-purple-600 transition-colors">
                                                    {{ p.name }}
                                                </a>
                                                <div class="text-[10px] text-slate-400">{{ p.category }}</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="font-bold text-rose-600 bg-rose-50 px-2 py-0.5 rounded-lg">
                                            {{ p.quantity }}
                                        </span>
                                    </td>
                                    <td class="py-3 text-right text-slate-600 font-medium">
                                        {{ p.minStock }}
                                    </td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="py-8 text-center text-slate-400">
                                        No low stock items! All inventory levels are healthy.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Quick Restock button -->
            <div class="pt-4 border-t border-slate-100 mt-2">
                <a href="{{ path('app_inventory_stock_in') }}" class="w-full py-2 px-3 bg-purple-50 hover:bg-purple-100 text-purple-700 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition-colors">
                    <i data-lucide="plus-circle" class="w-3.5 h-3.5"></i>
                    <span>Quick Restock Low Items</span>
                </a>
            </div>
        </div>
    </div>

    <!-- BOTTOM ROW: Recent Sales Table & Quick Actions -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
        <!-- Recent Sales Table Card (7 cols) -->
        <div class="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200/70 shadow-sm">
            <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-2.5">
                    <div class="p-1.5 bg-purple-100 text-[#7C3AED] rounded-lg">
                        <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                    </div>
                    <h2 class="text-base font-bold text-slate-800 font-display">Recent Sales</h2>
                </div>
                <a href="{{ path('app_sales_index') }}" class="text-xs font-semibold text-purple-600 hover:text-purple-700">
                    View All
                </a>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs">
                    <thead>
                        <tr class="text-slate-400 font-semibold border-b border-slate-100">
                            <th class="pb-3 font-medium">Date & Time</th>
                            <th class="pb-3 font-medium">Product</th>
                            <th class="pb-3 font-medium text-center">Quantity</th>
                            <th class="pb-3 font-medium text-right">Total Amount</th>
                            <th class="pb-3 font-medium text-right">Cashier</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-50">
                        {% for s in recent_sales %}
                            <tr class="hover:bg-slate-50/70 transition-colors">
                                <td class="py-3 text-slate-500 whitespace-nowrap">
                                    {{ s.createdAt|date('M d, Y h:i A') }}
                                </td>
                                <td class="py-3 font-semibold text-slate-800">
                                    {{ s.primaryProductName }}
                                </td>
                                <td class="py-3 text-center text-slate-600 font-medium">
                                    {{ s.totalUnits }}
                                </td>
                                <td class="py-3 text-right font-bold text-slate-900 whitespace-nowrap">
                                    ₱ {{ s.totalAmount|number_format(2, '.', ',') }}
                                </td>
                                <td class="py-3 text-right text-slate-500">
                                    <span class="bg-slate-100 px-2 py-0.5 rounded-md font-medium text-slate-600">
                                        {{ s.cashierName }}
                                    </span>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="5" class="py-8 text-center text-slate-400">
                                    No sales transactions recorded yet.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Quick Actions Card (5 cols) -->
        <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/70 shadow-sm">
            <div class="flex items-center gap-2.5 mb-5">
                <div class="p-1.5 bg-purple-100 text-[#7C3AED] rounded-lg">
                    <i data-lucide="zap" class="w-4 h-4"></i>
                </div>
                <h2 class="text-base font-bold text-slate-800 font-display">Quick Actions</h2>
            </div>

            <!-- 6 Actions in 2 columns x 3 rows matching mockup -->
            <div class="grid grid-cols-2 gap-3.5">
                <!-- 1. Add Product -->
                <a href="{{ path('app_product_new') }}" 
                   class="flex flex-col items-center justify-center p-4 rounded-2xl border border-slate-100 bg-[#F9F8FD] hover:bg-purple-50 hover:border-purple-200 transition-all text-center group shadow-sm hover:shadow">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i data-lucide="package" class="w-5 h-5"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-800">Add Product</span>
                </a>

                <!-- 2. Record Sale -->
                <a href="{{ path('app_sales_record') }}" 
                   class="flex flex-col items-center justify-center p-4 rounded-2xl border border-slate-100 bg-[#F9F8FD] hover:bg-purple-50 hover:border-purple-200 transition-all text-center group shadow-sm hover:shadow">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i data-lucide="shopping-cart" class="w-5 h-5"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-800">Record Sale</span>
                </a>

                <!-- 3. Stock In -->
                <a href="{{ path('app_inventory_stock_in') }}" 
                   class="flex flex-col items-center justify-center p-4 rounded-2xl border border-slate-100 bg-[#F9F8FD] hover:bg-purple-50 hover:border-purple-200 transition-all text-center group shadow-sm hover:shadow">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i data-lucide="plus-circle" class="w-5 h-5"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-800">Stock In</span>
                </a>

                <!-- 4. View Reports -->
                <a href="{{ path('app_reports_index') }}" 
                   class="flex flex-col items-center justify-center p-4 rounded-2xl border border-slate-100 bg-[#F9F8FD] hover:bg-purple-50 hover:border-purple-200 transition-all text-center group shadow-sm hover:shadow">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i data-lucide="bar-chart-3" class="w-5 h-5"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-800">View Reports</span>
                </a>

                <!-- 5. Manage Staff -->
                <a href="{{ path('app_staff_index') }}" 
                   class="flex flex-col items-center justify-center p-4 rounded-2xl border border-slate-100 bg-[#F9F8FD] hover:bg-purple-50 hover:border-purple-200 transition-all text-center group shadow-sm hover:shadow">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i data-lucide="user-check" class="w-5 h-5"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-800">Manage Staff</span>
                </a>

                <!-- 6. Settings -->
                <a href="{{ path('app_settings_index') }}" 
                   class="flex flex-col items-center justify-center p-4 rounded-2xl border border-slate-100 bg-[#F9F8FD] hover:bg-purple-50 hover:border-purple-200 transition-all text-center group shadow-sm hover:shadow">
                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-2 group-hover:scale-110 transition-transform">
                        <i data-lucide="settings" class="w-5 h-5"></i>
                    </div>
                    <span class="text-xs font-semibold text-slate-700 group-hover:text-purple-800">Settings</span>
                </a>
            </div>
        </div>
    </div>
</div>

<script>
    // Live date and clock matching September 29, 2026 10:24 AM style
    function updateLiveClock() {
        const now = new Date();
        const dateOptions = { month: 'long', day: 'numeric', year: 'numeric' };
        const timeOptions = { hour: 'numeric', minute: '2-digit', hour12: true };
        
        const dateEl = document.getElementById('live-date');
        const timeEl = document.getElementById('live-time');
        
        if (dateEl && timeEl) {
            dateEl.textContent = now.toLocaleDateString('en-US', dateOptions);
            timeEl.textContent = now.toLocaleTimeString('en-US', timeOptions);
        }
    }
    updateLiveClock();
    setInterval(updateLiveClock, 1000);

    // Sales Overview Current Dynamic Datasets
    const chartDataSets = {{ chart_data|json_encode|raw }};

    let salesChartInstance = null;

    function renderSalesChart(mode = 'daily') {
        const ctx = document.getElementById('salesOverviewChart');
        if (!ctx) return;

        const config = chartDataSets[mode];

        if (salesChartInstance) {
            salesChartInstance.destroy();
        }

        salesChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: config.labels,
                datasets: [{
                    label: 'Sales (₱)',
                    data: config.data,
                    backgroundColor: '#7C3AED',
                    hoverBackgroundColor: '#6D28D9',
                    borderRadius: 6,
                    barPercentage: 0.5,
                    categoryPercentage: 0.7
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#1E0C38',
                        padding: 10,
                        cornerRadius: 8,
                        callbacks: {
                            label: function(context) {
                                return ' ₱ ' + Number(context.raw).toLocaleString('en-US', {minimumFractionDigits: 2});
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return '₱ ' + (value >= 1000 ? (value / 1000) + 'k' : value);
                            },
                            font: { size: 10, family: 'Inter' },
                            color: '#94A3B8'
                        },
                        grid: {
                            color: '#F1F5F9',
                            drawBorder: false
                        }
                    },
                    x: {
                        ticks: {
                            font: { size: 10, family: 'Inter' },
                            color: '#64748B'
                        },
                        grid: { display: false }
                    }
                }
            }
        });
    }

    function switchChartMode(mode) {
        ['daily', 'weekly', 'monthly'].forEach(m => {
            const btn = document.getElementById('tab-' + m);
            if (btn) {
                if (m === mode) {
                    btn.className = 'px-3 py-1.5 rounded-lg bg-[#7C3AED] text-white shadow-sm font-semibold transition-all';
                } else {
                    btn.className = 'px-3 py-1.5 rounded-lg hover:text-slate-900 transition-all text-slate-600';
                }
            }
        });
        renderSalesChart(mode);
    }

    document.addEventListener('DOMContentLoaded', () => {
        renderSalesChart('daily');
    });
</script>
{% endblock %}
