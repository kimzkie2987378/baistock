{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Products Catalog - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Products Management</h1>
            <p class="text-slate-500 text-sm">Manage inventory items, pricing, SKU codes, and reorder levels.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="{{ path('app_product_export_csv') }}" class="py-2.5 px-4 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm transition-all">
                <i data-lucide="download" class="w-4 h-4 text-slate-500"></i>
                <span>Export CSV</span>
            </a>
            <a href="{{ path('app_product_new') }}" class="py-2.5 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold flex items-center gap-2 shadow-lg shadow-purple-600/30 transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Add Product</span>
            </a>
        </div>
    </div>

    <!-- Filters & Search Toolbar -->
    <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
        <!-- Live search -->
        <form action="{{ path('app_product_index') }}" method="get" class="flex-1 max-w-md flex items-center gap-2">
            <div class="relative w-full">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none text-slate-400">
                    <i data-lucide="search" class="w-4 h-4"></i>
                </div>
                <input type="text" name="q" value="{{ search_query }}" placeholder="Search by name, SKU, or category..."
                       class="w-full pl-9 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 transition-all">
            </div>
            {% if current_category %}
                <input type="hidden" name="category" value="{{ current_category }}">
            {% endif %}
            {% if current_stock %}
                <input type="hidden" name="stock" value="{{ current_stock }}">
            {% endif %}
            <button type="submit" class="py-2 px-3 bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-xl text-xs font-semibold">
                Search
            </button>
        </form>

        <!-- Category & Stock status filters -->
        <div class="flex items-center gap-2 flex-wrap text-xs">
            <span class="text-slate-400 font-medium">Filter:</span>
            <!-- Stock status buttons -->
            <a href="{{ path('app_product_index', {'category': current_category, 'q': search_query}) }}" 
               class="px-3 py-1.5 rounded-lg {{ not current_stock ? 'bg-[#7C3AED] text-white font-semibold' : 'bg-slate-100 text-slate-600 hover:bg-slate-200' }}">
               All ({{ products|length }})
            </a>
            <a href="{{ path('app_product_index', {'stock': 'low', 'category': current_category, 'q': search_query}) }}" 
               class="px-3 py-1.5 rounded-lg {{ current_stock == 'low' ? 'bg-rose-600 text-white font-semibold' : 'bg-rose-50 text-rose-700 hover:bg-rose-100' }}">
               Low Stock
            </a>
            <a href="{{ path('app_product_index', {'stock': 'out', 'category': current_category, 'q': search_query}) }}" 
               class="px-3 py-1.5 rounded-lg {{ current_stock == 'out' ? 'bg-slate-800 text-white font-semibold' : 'bg-slate-100 text-slate-700 hover:bg-slate-200' }}">
               Out of Stock
            </a>

            <!-- Category dropdown -->
            <select onchange="window.location.href=this.value" class="py-1.5 px-3 bg-slate-50 border border-slate-200 rounded-lg text-xs font-medium text-slate-700 focus:outline-none focus:border-purple-600">
                <option value="{{ path('app_product_index', {'stock': current_stock, 'q': search_query}) }}">All Categories</option>
                {% for cat in categories %}
                    <option value="{{ path('app_product_index', {'category': cat, 'stock': current_stock, 'q': search_query}) }}" {{ current_category == cat ? 'selected' : '' }}>
                        {{ cat }}
                    </option>
                {% endfor %}
            </select>
        </div>
    </div>

    <!-- Products Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Product</th>
                        <th class="py-3.5 px-4">SKU</th>
                        <th class="py-3.5 px-4">Category</th>
                        <th class="py-3.5 px-4 text-right">Unit Price</th>
                        <th class="py-3.5 px-4 text-center">Stock Level</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for p in products %}
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <!-- Product Name & Thumbnail -->
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-12 h-12 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center text-lg flex-shrink-0 overflow-hidden shadow-sm">
                                        {% if p.imagePath %}
                                            <img src="{{ asset('uploads/products/' ~ p.imagePath) }}" alt="{{ p.name }}" class="w-full h-full object-cover rounded-xl">
                                        {% elseif p.category == 'Snacks' %}🍿
                                        {% elseif p.category == 'Fruits' %}🍎
                                        {% elseif p.category == 'Canned Goods' %}🥫
                                        {% elseif p.category == 'Vegetables' %}🥕
                                        {% elseif p.category == 'Groceries' %}🛒
                                        {% else %}📦{% endif %}
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800">{{ p.name }}</div>
                                        <div class="text-xs text-slate-400 truncate max-w-xs">{{ p.description ?: 'No description' }}</div>
                                    </div>
                                </div>
                            </td>

                            <!-- SKU -->
                            <td class="py-4 px-4 text-xs font-mono font-medium text-purple-700 bg-purple-50/50 rounded-lg inline-block my-3">
                                {{ p.sku }}
                            </td>

                            <!-- Category -->
                            <td class="py-4 px-4 text-xs text-slate-600 font-medium">
                                {{ p.category }}
                            </td>

                            <!-- Price -->
                            <td class="py-4 px-4 text-right font-bold text-slate-900">
                                ₱ {{ p.price|number_format(2, '.', ',') }}
                            </td>

                            <!-- Stock Quantity & Progress -->
                            <td class="py-4 px-4 text-center">
                                <div class="inline-flex flex-col items-center">
                                    <span class="font-bold {{ p.isLowStock ? 'text-rose-600 font-extrabold' : (p.isOutOfStock ? 'text-slate-400' : 'text-slate-800') }}">
                                        {{ p.quantity }}
                                    </span>
                                    <span class="text-[10px] text-slate-400">Min: {{ p.minStock }}</span>
                                </div>
                            </td>

                            <!-- Status Badge -->
                            <td class="py-4 px-4 text-center">
                                {% if p.isOutOfStock %}
                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-rose-700 bg-rose-50 border border-rose-200 px-2.5 py-0.5 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-rose-600"></span> Out of Stock
                                    </span>
                                {% elseif p.isLowStock %}
                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2.5 py-0.5 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-amber-500"></span> Low Stock
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> In Stock
                                    </span>
                                {% endif %}
                            </td>

                            <!-- Actions -->
                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_product_edit', {'id': p.id}) }}" class="p-1.5 text-slate-500 hover:text-purple-600 hover:bg-purple-50 rounded-lg transition-colors" title="Edit Product">
                                        <i data-lucide="edit-3" class="w-4 h-4"></i>
                                    </a>

                                    {% if is_granted('ROLE_OWNER') or is_granted('ROLE_ADMIN') %}
                                        <form method="post" action="{{ path('app_product_delete', {'id': p.id}) }}" onsubmit="return confirm('Are you sure you want to delete {{ p.name }}?');" class="inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_product_' ~ p.id) }}">
                                            <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Product">
                                                <i data-lucide="trash-2" class="w-4 h-4"></i>
                                            </button>
                                        </form>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center">
                                    <i data-lucide="package-search" class="w-10 h-10 text-slate-300 mb-2"></i>
                                    <p class="font-medium">No products found matching your criteria.</p>
                                    <a href="{{ path('app_product_index') }}" class="text-xs text-purple-600 font-semibold mt-2 hover:underline">Clear all filters</a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
