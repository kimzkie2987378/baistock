{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Edit Product - {{ product.name }}{% endblock %}

{% block content %}
<div class="max-w-3xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a href="{{ path('app_product_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Edit Product</h1>
            <p class="text-slate-500 text-sm">Update details, picture, and pricing for <span class="font-semibold text-purple-700">{{ product.name }}</span> ({{ product.sku }})</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <form action="{{ path('app_product_edit', {'id': product.id}) }}" method="post" enctype="multipart/form-data" class="space-y-6">
            
            <!-- PRODUCT PICTURE UPLOAD BOX -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 uppercase tracking-wider mb-2">Product Picture / Stock Image</label>
                <div class="relative border-2 border-dashed border-purple-200 hover:border-purple-400 bg-purple-50/30 hover:bg-purple-50/60 rounded-2xl p-6 transition-all text-center cursor-pointer group"
                     id="dropzone" onclick="document.getElementById('product_image_input').click()">
                    
                    <input type="file" name="product_image" id="product_image_input" accept="image/*" class="hidden" onchange="previewProductImage(this)">
                    <input type="hidden" name="remove_image" id="remove_image_input" value="0">
                    
                    <!-- Preview Container -->
                    <div id="image-preview-container" class="{{ product.imagePath ? 'flex' : 'hidden' }} flex-col items-center justify-center">
                        <div class="relative w-40 h-40 rounded-2xl overflow-hidden shadow-md border-2 border-purple-400 mb-3 bg-white">
                            <img id="image-preview" 
                                 src="{{ product.imagePath ? asset('uploads/products/' ~ product.imagePath) : '#' }}" 
                                 alt="{{ product.name }}" 
                                 class="w-full h-full object-cover">
                            <button type="button" onclick="event.stopPropagation(); removeProductImagePreview()" class="absolute top-2 right-2 w-7 h-7 bg-rose-600 hover:bg-rose-700 text-white rounded-full flex items-center justify-center shadow-md" title="Remove picture">
                                <i data-lucide="x" class="w-4 h-4"></i>
                            </button>
                        </div>
                        <span class="text-xs text-purple-700 font-semibold hover:underline">Click to change picture</span>
                    </div>

                    <!-- Placeholder Container -->
                    <div id="image-placeholder" class="{{ product.imagePath ? 'hidden' : 'flex' }} flex-col items-center justify-center py-4">
                        <div class="w-16 h-16 rounded-2xl bg-purple-100 text-[#7C3AED] flex items-center justify-center mb-3 group-hover:scale-110 transition-transform">
                            <i data-lucide="image-plus" class="w-8 h-8"></i>
                        </div>
                        <p class="text-sm font-bold text-slate-800">Click to upload stock picture</p>
                        <p class="text-xs text-slate-500 mt-1">PNG, JPG, JPEG, or WEBP (Max 5MB)</p>
                        <span class="mt-3 px-3.5 py-1.5 rounded-lg bg-white border border-purple-200 text-xs font-semibold text-purple-700 shadow-sm group-hover:bg-[#7C3AED] group-hover:text-white transition-colors">
                            Browse File
                        </span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <!-- SKU (Readonly for consistency) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">SKU / Barcode</label>
                    <input type="text" value="{{ product.sku }}" readonly
                           class="w-full px-3.5 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-sm font-mono text-slate-500 cursor-not-allowed">
                </div>

                <!-- Category -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Category *</label>
                    <select name="category" required class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                        {% set standardCats = ['Snacks', 'Fruits', 'Canned Goods', 'Vegetables', 'Groceries'] %}
                        {% for cat in standardCats %}
                            <option value="{{ cat }}" {{ product.category == cat ? 'selected' : '' }}>{{ cat }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <!-- Product Name -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Product Name *</label>
                <input type="text" name="name" value="{{ product.name }}" required
                       class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- Unit Price -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Selling Price (₱) *</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold">₱</span>
                        <input type="number" name="price" value="{{ product.price }}" step="0.25" min="0" required
                               class="w-full pl-8 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    </div>
                </div>

                <!-- Current Stock (Use Stock In to add stock) -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Current Stock</label>
                    <div class="flex items-center gap-2">
                        <input type="text" value="{{ product.quantity }} units" readonly
                               class="w-full px-3.5 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-sm font-bold text-slate-700 cursor-not-allowed">
                        <a href="{{ path('app_inventory_stock_in', {'product_id': product.id}) }}" class="p-2.5 bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-xl" title="Stock In">
                            <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        </a>
                    </div>
                </div>

                <!-- Minimum / Reorder Level -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Min Reorder Level *</label>
                    <input type="number" name="minStock" value="{{ product.minStock }}" min="1" required
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>
            </div>

            <!-- Description -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Description / Notes</label>
                <textarea name="description" rows="3"
                          class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">{{ product.description }}</textarea>
            </div>

            <!-- Action buttons -->
            <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                <span class="text-xs text-slate-400">Created {{ product.createdAt|date('M d, Y') }}</span>
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_product_index') }}" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="py-2.5 px-6 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-lg shadow-purple-600/30 transition-all flex items-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Update Product</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<script>
    function previewProductImage(input) {
        if (input.files && input.files[0]) {
            const reader = new FileReader();
            reader.onload = function(e) {
                document.getElementById('image-preview').src = e.target.result;
                document.getElementById('image-preview-container').classList.remove('hidden');
                document.getElementById('image-preview-container').classList.add('flex');
                document.getElementById('image-placeholder').classList.add('hidden');
                document.getElementById('remove_image_input').value = '0';
            }
            reader.readAsDataURL(input.files[0]);
        }
    }

    function removeProductImagePreview() {
        const input = document.getElementById('product_image_input');
        input.value = '';
        document.getElementById('image-preview').src = '#';
        document.getElementById('image-preview-container').classList.add('hidden');
        document.getElementById('image-preview-container').classList.remove('flex');
        document.getElementById('image-placeholder').classList.remove('hidden');
        document.getElementById('remove_image_input').value = '1';
    }
</script>
{% endblock %}
