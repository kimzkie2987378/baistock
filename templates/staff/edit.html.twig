{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Edit Staff Account - {{ staff.fullName ?: staff.username }}{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a href="{{ path('app_staff_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Edit Staff Account</h1>
            <p class="text-slate-500 text-sm">Update staff details, change email address, or reset account password.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <form action="{{ path('app_staff_edit', {'id': staff.id}) }}" method="post" class="space-y-5">
            <!-- Username (read-only for security) -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Username (Login ID)</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="at-sign" class="w-4 h-4"></i>
                    </div>
                    <input type="text" value="{{ staff.username }}" readonly
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-100 border border-slate-200 rounded-xl text-sm font-mono text-slate-500 cursor-not-allowed">
                </div>
            </div>

            <!-- Full Name -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Full Name *</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="user" class="w-4 h-4"></i>
                    </div>
                    <input type="text" name="full_name" value="{{ staff.fullName }}" required
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>
            </div>

            <!-- Email (Requested feature: can change email) -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Email Address *</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="mail" class="w-4 h-4"></i>
                    </div>
                    <input type="email" name="email" value="{{ staff.email }}" required
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>
                <p class="text-[11px] text-slate-400 mt-1">Change the staff email used for communication and login.</p>
            </div>

            <!-- Status -->
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Account Status</label>
                <select name="status" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    <option value="active" {{ staff.status == 'active' ? 'selected' : '' }}>Active (Can Log In)</option>
                    <option value="inactive" {{ staff.status == 'inactive' ? 'selected' : '' }}>Inactive (Suspended)</option>
                </select>
            </div>

            <!-- Change Password Section (Requested feature: can change password) -->
            <div class="p-4 bg-purple-50/60 border border-purple-100 rounded-2xl space-y-2">
                <div class="flex items-center gap-2">
                    <i data-lucide="key-round" class="w-4 h-4 text-[#7C3AED]"></i>
                    <label class="text-xs font-bold text-purple-900 uppercase tracking-wide">Change Password</label>
                </div>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="lock" class="w-4 h-4"></i>
                    </div>
                    <input type="password" name="password" placeholder="Leave blank to keep current password"
                           class="w-full pl-10 pr-4 py-2.5 bg-white border border-purple-200 rounded-xl text-sm text-slate-800 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-100">
                </div>
                <p class="text-[11px] text-purple-700/80">Only fill this in if you want to set a new password for this staff member.</p>
            </div>

            <!-- Action buttons -->
            <div class="flex items-center justify-between pt-3 border-t border-slate-100">
                <span class="text-xs text-slate-400">Registered: {{ staff.createdAt ? staff.createdAt|date('M d, Y') : 'N/A' }}</span>
                <div class="flex items-center gap-3">
                    <a href="{{ path('app_staff_index') }}" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-colors">
                        Cancel
                    </a>
                    <button type="submit" class="py-2.5 px-6 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-lg shadow-purple-600/30 transition-all flex items-center gap-2">
                        <i data-lucide="save" class="w-4 h-4"></i>
                        <span>Update Staff</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>
{% endblock %}
