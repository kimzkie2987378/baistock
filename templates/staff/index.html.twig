{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Staff Management - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Staff Management</h1>
            <p class="text-slate-500 text-sm">View, add, edit staff accounts, change email or reset password.</p>
        </div>

        <a href="{{ path('app_staff_new') }}" class="py-2.5 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold flex items-center gap-2 shadow-lg shadow-purple-600/30 transition-all self-start sm:self-auto">
            <i data-lucide="user-plus" class="w-4 h-4"></i>
            <span>Add New Staff</span>
        </a>
    </div>

    <!-- Staff Table Card -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Staff Member</th>
                        <th class="py-3.5 px-4">Username</th>
                        <th class="py-3.5 px-4">Email</th>
                        <th class="py-3.5 px-4 text-center">Status</th>
                        <th class="py-3.5 px-4">Created Date</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for s in staff %}
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-4 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-purple-100 text-[#7C3AED] flex items-center justify-center font-bold text-sm shadow-sm flex-shrink-0">
                                        {{ s.fullName ? s.fullName|slice(0, 1)|upper : s.username|slice(0, 1)|upper }}
                                    </div>
                                    <div>
                                        <div class="font-bold text-slate-800">{{ s.fullName ?: s.username }}</div>
                                        <div class="text-xs text-purple-600 font-medium">Store Staff / Cashier</div>
                                    </div>
                                </div>
                            </td>

                            <td class="py-4 px-4 font-mono text-xs text-slate-600 font-semibold">
                                @{{ s.username }}
                            </td>

                            <td class="py-4 px-4 text-xs text-slate-600">
                                {{ s.email }}
                            </td>

                            <td class="py-4 px-4 text-center">
                                {% if s.status == 'active' %}
                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Active
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-600 bg-slate-100 border border-slate-200 px-2.5 py-0.5 rounded-full">
                                        <span class="w-1.5 h-1.5 rounded-full bg-slate-400"></span> Inactive
                                    </span>
                                {% endif %}
                            </td>

                            <td class="py-4 px-4 text-xs text-slate-500">
                                {{ s.createdAt ? s.createdAt|date('M d, Y') : 'N/A' }}
                            </td>

                            <td class="py-4 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_staff_edit', {'id': s.id}) }}" class="py-1.5 px-3 bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-lg text-xs font-semibold flex items-center gap-1.5 transition-colors">
                                        <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                        <span>Edit & Password</span>
                                    </a>

                                    <form action="{{ path('app_staff_delete', {'id': s.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this staff account?');" class="inline">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_staff_' ~ s.id) }}">
                                        <button type="submit" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Delete Staff">
                                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                <div class="flex flex-col items-center justify-center">
                                    <i data-lucide="users" class="w-12 h-12 text-slate-300 mb-2"></i>
                                    <p class="font-medium text-slate-600">No staff accounts registered yet.</p>
                                    <p class="text-xs text-slate-400 mt-1">Click "Add New Staff" to create an employee account.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
