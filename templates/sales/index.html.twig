{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Sales History - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Sales Transactions</h1>
            <p class="text-slate-500 text-sm">Review past sales, cashier logs, and reprint customer receipts.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="{{ path('app_sales_record') }}" class="py-2.5 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold flex items-center gap-2 shadow-lg shadow-purple-600/30 transition-all">
                <i data-lucide="plus" class="w-4 h-4"></i>
                <span>Record New Sale (POS)</span>
            </a>
        </div>
    </div>

    <!-- Sales Stat Card -->
    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
        <div>
            <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Recorded Sales</span>
            <div class="text-3xl font-extrabold text-slate-900 mt-1 font-display">
                ₱ {{ total_sales|number_format(2, '.', ',') }}
            </div>
        </div>
        <div class="w-12 h-12 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
            <i data-lucide="shopping-cart" class="w-6 h-6"></i>
        </div>
    </div>

    <!-- Sales Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="py-3 px-6">Receipt #</th>
                        <th class="py-3 px-4">Date & Time</th>
                        <th class="py-3 px-4">Items Summary</th>
                        <th class="py-3 px-4 text-center">Qty</th>
                        <th class="py-3 px-4 text-right">Total Amount</th>
                        <th class="py-3 px-4 text-center">Payment</th>
                        <th class="py-3 px-4 text-center">Cashier</th>
                        <th class="py-3 px-6 text-right">Receipt</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    {% for s in sales %}
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3.5 px-6 font-mono font-bold text-purple-700">
                                {{ s.receiptNumber }}
                            </td>
                            <td class="py-3.5 px-4 text-slate-500 whitespace-nowrap">
                                {{ s.createdAt|date('M d, Y h:i A') }}
                            </td>
                            <td class="py-3.5 px-4 font-semibold text-slate-800">
                                {{ s.primaryProductName }}
                            </td>
                            <td class="py-3.5 px-4 text-center font-bold text-slate-700">
                                {{ s.totalUnits }}
                            </td>
                            <td class="py-3.5 px-4 text-right font-extrabold text-slate-900 text-sm whitespace-nowrap">
                                ₱ {{ s.totalAmount|number_format(2, '.', ',') }}
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <span class="bg-slate-100 text-slate-700 font-medium px-2 py-0.5 rounded-md">
                                    {{ s.paymentMethod }}
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-center text-slate-600">
                                {{ s.cashierName }}
                            </td>
                            <td class="py-3.5 px-6 text-right">
                                <a href="{{ path('app_receipts_show', {'id': s.id}) }}" class="py-1 px-2.5 bg-purple-50 hover:bg-purple-100 text-purple-700 rounded-lg inline-flex items-center gap-1 font-semibold text-xs transition-colors">
                                    <i data-lucide="receipt" class="w-3.5 h-3.5"></i>
                                    <span>Show Full Receipt</span>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8" class="py-12 text-center text-slate-400">
                                No sales transactions found.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
