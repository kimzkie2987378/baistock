{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Record Sale / POS - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="h-full flex flex-col gap-5">
    <!-- Header banner -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a href="{{ path('app_sales_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Record Sale / Point of Sale</h1>
                <p class="text-slate-500 text-sm">Select items, compute total, receive payment, and auto-update stock.</p>
            </div>
        </div>

        <div class="flex items-center gap-2">
            <span class="text-xs bg-purple-100 text-purple-800 font-semibold px-3 py-1.5 rounded-xl flex items-center gap-1.5">
                <i data-lucide="user" class="w-3.5 h-3.5"></i>
                Cashier: {{ app.user ? (app.user.fullName ?: app.user.userIdentifier) : 'Admin' }}
            </span>
        </div>
    </div>

    <!-- POS Main Grid: Products on Left (7 cols), Cart on Right (5 cols) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 flex-1 items-start">
        
        <!-- PRODUCTS SELECTOR PANEL (7 COLS) -->
        <div class="lg:col-span-7 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col gap-4">
            <!-- Search & Category Filters -->
            <div class="flex flex-col sm:flex-row items-center gap-3">
                <div class="relative w-full">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </div>
                    <input type="text" id="pos-search" placeholder="Search product name or SKU..." 
                           class="w-full pl-10 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>

                <div class="flex items-center gap-1.5 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                    <button type="button" onclick="filterCategory('all')" class="cat-pill active px-3 py-1.5 rounded-lg text-xs font-semibold bg-[#7C3AED] text-white">All</button>
                    {% for cat in categories %}
                        <button type="button" onclick="filterCategory('{{ cat }}')" class="cat-pill px-3 py-1.5 rounded-lg text-xs font-medium bg-slate-100 text-slate-600 hover:bg-slate-200 whitespace-nowrap">
                            {{ cat }}
                        </button>
                    {% endfor %}
                </div>
            </div>

            <!-- Product Cards Grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 max-h-[520px] overflow-y-auto p-1" id="products-grid">
                {% for p in products %}
                    <div class="product-item p-3 rounded-2xl border border-slate-200 hover:border-purple-500 hover:shadow-md transition-all cursor-pointer bg-white flex flex-col justify-between select-none relative group {{ p.isOutOfStock ? 'opacity-50 pointer-events-none' : '' }}"
                         data-id="{{ p.id }}"
                         data-name="{{ p.name }}"
                         data-sku="{{ p.sku }}"
                         data-price="{{ p.price }}"
                         data-stock="{{ p.quantity }}"
                         data-category="{{ p.category }}"
                         onclick="addToCart({{ p.id }}, '{{ p.name|e('js') }}', {{ p.price }}, {{ p.quantity }})">
                        
                        <div>
                            <!-- Product Image Thumbnail -->
                            <div class="w-full h-24 mb-2.5 rounded-xl bg-purple-50/60 border border-purple-100/80 flex items-center justify-center overflow-hidden">
                                {% if p.imagePath %}
                                    <img src="{{ asset('uploads/products/' ~ p.imagePath) }}" alt="{{ p.name }}" class="w-full h-full object-cover">
                                {% else %}
                                    <div class="text-2xl opacity-70">
                                        {% if p.category == 'Snacks' %}🍿
                                        {% elseif p.category == 'Fruits' %}🍎
                                        {% elseif p.category == 'Canned Goods' %}🥫
                                        {% elseif p.category == 'Vegetables' %}🥕
                                        {% elseif p.category == 'Groceries' %}🛒
                                        {% else %}📦{% endif %}
                                    </div>
                                {% endif %}
                            </div>

                            <div class="flex items-center justify-between mb-1">
                                <span class="text-[10px] font-mono font-medium text-slate-400">{{ p.sku }}</span>
                                <span class="text-[10px] font-semibold px-2 py-0.5 rounded-full {{ p.isLowStock ? 'bg-amber-100 text-amber-700' : (p.isOutOfStock ? 'bg-rose-100 text-rose-700' : 'bg-slate-100 text-slate-600') }}">
                                    Stock: {{ p.quantity }}
                                </span>
                            </div>
                            <h4 class="font-bold text-slate-800 text-xs line-clamp-1">{{ p.name }}</h4>
                        </div>

                        <div class="mt-3 flex items-center justify-between pt-2 border-t border-slate-100">
                            <span class="font-extrabold text-sm text-purple-700">₱ {{ p.price|number_format(2, '.', ',') }}</span>
                            <span class="w-6 h-6 rounded-lg bg-purple-50 text-[#7C3AED] flex items-center justify-center text-xs group-hover:bg-[#7C3AED] group-hover:text-white transition-colors">
                                +
                            </span>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- CART & CHECKOUT PANEL (5 COLS) -->
        <div class="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <i data-lucide="shopping-bag" class="w-5 h-5 text-purple-600"></i>
                        <h2 class="text-base font-bold text-slate-800 font-display">Current Sale Order</h2>
                    </div>
                    <button type="button" onclick="clearCart()" class="text-xs text-rose-600 hover:underline font-semibold">
                        Clear
                    </button>
                </div>

                <!-- Cart Items List -->
                <div id="cart-list" class="divide-y divide-slate-100 max-h-64 overflow-y-auto my-3 min-h-[140px]">
                    <div id="empty-cart-msg" class="py-12 text-center text-slate-400">
                        <i data-lucide="shopping-cart" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                        <p class="text-xs font-medium">Cart is empty. Click items on the left to add.</p>
                    </div>
                </div>
            </div>

            <!-- Checkout Form & Totals -->
            <form id="checkout-form" action="{{ path('app_sales_record') }}" method="post" class="space-y-4 pt-3 border-t border-slate-100">
                <input type="hidden" name="items_json" id="items_json" value="[]">

                <!-- Totals Breakdown -->
                <div class="space-y-1.5 text-xs">
                    <div class="flex justify-between text-slate-500">
                        <span>Items Subtotal:</span>
                        <span id="summary-subtotal" class="font-medium text-slate-800">₱ 0.00</span>
                    </div>
                    <div class="flex justify-between text-slate-500">
                        <span>Tax / Discounts:</span>
                        <span class="font-medium text-slate-800">₱ 0.00</span>
                    </div>
                    <div class="flex justify-between text-base font-extrabold text-slate-900 pt-2 border-t border-slate-100">
                        <span>Total Due:</span>
                        <span id="summary-total" class="text-purple-700 font-display text-lg">₱ 0.00</span>
                    </div>
                </div>

                <!-- Payment Method -->
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Payment Method</label>
                    <div class="grid grid-cols-3 gap-2">
                        <label class="payment-method-btn flex items-center justify-center gap-1.5 p-2 rounded-xl border border-purple-500 bg-purple-50 text-purple-700 text-xs font-semibold cursor-pointer">
                            <input type="radio" name="payment_method" value="Cash" checked class="hidden" onchange="updatePaymentMethod(this)">
                            <span>💵 Cash</span>
                        </label>
                        <label class="payment-method-btn flex items-center justify-center gap-1.5 p-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold cursor-pointer">
                            <input type="radio" name="payment_method" value="GCash" class="hidden" onchange="updatePaymentMethod(this)">
                            <span>📱 GCash</span>
                        </label>
                        <label class="payment-method-btn flex items-center justify-center gap-1.5 p-2 rounded-xl border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold cursor-pointer">
                            <input type="radio" name="payment_method" value="Maya" class="hidden" onchange="updatePaymentMethod(this)">
                            <span>💳 Maya</span>
                        </label>
                    </div>
                </div>

                <!-- Amount Tendered / Cash Paid & Change -->
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Cash Tendered (₱)</label>
                        <input type="number" step="1" min="0" id="amount_paid" name="amount_paid" placeholder="0.00"
                               oninput="calculateChange()"
                               class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-900 focus:bg-white focus:outline-none focus:border-purple-600">
                    </div>
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Change (₱)</label>
                        <div id="summary-change" class="w-full px-3 py-2 bg-emerald-50 border border-emerald-200 rounded-xl text-sm font-bold text-emerald-700 flex items-center">
                            ₱ 0.00
                        </div>
                    </div>
                </div>

                <!-- Complete Sale Button -->
                <button type="submit" id="submit-sale-btn" disabled
                        class="w-full py-3.5 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] disabled:opacity-50 disabled:cursor-not-allowed text-white font-bold rounded-xl shadow-lg shadow-purple-600/30 flex items-center justify-center gap-2 transition-all">
                    <i data-lucide="check-circle" class="w-5 h-5"></i>
                    <span>Complete Sale & Print Receipt</span>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    let cart = [];

    function addToCart(id, name, price, maxStock) {
        const existing = cart.find(i => i.id === id);
        if (existing) {
            if (existing.qty < maxStock) {
                existing.qty++;
            } else {
                alert('Cannot exceed available stock (' + maxStock + ' units)');
            }
        } else {
            cart.push({ id, name, price, qty: 1, maxStock });
        }
        renderCart();
    }

    function updateQty(id, delta) {
        const item = cart.find(i => i.id === id);
        if (!item) return;

        item.qty += delta;
        if (item.qty <= 0) {
            cart = cart.filter(i => i.id !== id);
        } else if (item.qty > item.maxStock) {
            item.qty = item.maxStock;
            alert('Cannot exceed available stock (' + item.maxStock + ' units)');
        }
        renderCart();
    }

    function removeFromCart(id) {
        cart = cart.filter(i => i.id !== id);
        renderCart();
    }

    function clearCart() {
        cart = [];
        renderCart();
    }

    function renderCart() {
        const list = document.getElementById('cart-list');
        const emptyMsg = document.getElementById('empty-cart-msg');
        const submitBtn = document.getElementById('submit-sale-btn');
        const itemsJson = document.getElementById('items_json');

        if (cart.length === 0) {
            list.innerHTML = `
                <div id="empty-cart-msg" class="py-12 text-center text-slate-400">
                    <i data-lucide="shopping-cart" class="w-8 h-8 mx-auto mb-2 text-slate-300"></i>
                    <p class="text-xs font-medium">Cart is empty. Click items on the left to add.</p>
                </div>
            `;
            submitBtn.disabled = true;
            document.getElementById('summary-subtotal').textContent = '₱ 0.00';
            document.getElementById('summary-total').textContent = '₱ 0.00';
            itemsJson.value = '[]';
            calculateChange();
            if (window.lucide) lucide.createIcons();
            return;
        }

        let total = 0;
        let html = '';

        cart.forEach(item => {
            const lineTotal = item.price * item.qty;
            total += lineTotal;
            html += `
                <div class="py-2.5 flex items-center justify-between text-xs">
                    <div class="flex-1 pr-2">
                        <div class="font-bold text-slate-800">${item.name}</div>
                        <div class="text-[11px] text-slate-400">₱ ${item.price.toFixed(2)} each</div>
                    </div>
                    <div class="flex items-center gap-2">
                        <div class="flex items-center border border-slate-200 rounded-lg overflow-hidden">
                            <button type="button" onclick="updateQty(${item.id}, -1)" class="px-2 py-0.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold">-</button>
                            <span class="px-2.5 py-0.5 font-bold text-slate-900">${item.qty}</span>
                            <button type="button" onclick="updateQty(${item.id}, 1)" class="px-2 py-0.5 bg-slate-50 hover:bg-slate-100 text-slate-700 font-bold">+</button>
                        </div>
                        <div class="w-16 text-right font-bold text-slate-900">
                            ₱ ${lineTotal.toFixed(2)}
                        </div>
                        <button type="button" onclick="removeFromCart(${item.id})" class="text-slate-300 hover:text-rose-600 ml-1">
                            &times;
                        </button>
                    </div>
                </div>
            `;
        });

        list.innerHTML = html;
        submitBtn.disabled = false;
        itemsJson.value = JSON.stringify(cart);

        document.getElementById('summary-subtotal').textContent = '₱ ' + total.toLocaleString('en-US', {minimumFractionDigits: 2});
        document.getElementById('summary-total').textContent = '₱ ' + total.toLocaleString('en-US', {minimumFractionDigits: 2});

        const amountInput = document.getElementById('amount_paid');
        if (!amountInput.value || parseFloat(amountInput.value) < total) {
            amountInput.value = total.toFixed(2);
        }
        calculateChange();
    }

    function calculateChange() {
        const totalText = document.getElementById('summary-total').textContent.replace(/[^\d.]/g, '');
        const total = parseFloat(totalText) || 0;
        const paid = parseFloat(document.getElementById('amount_paid').value) || 0;
        const change = Math.max(0, paid - total);
        document.getElementById('summary-change').textContent = '₱ ' + change.toLocaleString('en-US', {minimumFractionDigits: 2});
    }

    function updatePaymentMethod(radio) {
        document.querySelectorAll('.payment-method-btn').forEach(btn => {
            btn.classList.remove('border-purple-500', 'bg-purple-50', 'text-purple-700');
            btn.classList.add('border-slate-200', 'text-slate-700');
        });
        radio.parentElement.classList.remove('border-slate-200', 'text-slate-700');
        radio.parentElement.classList.add('border-purple-500', 'bg-purple-50', 'text-purple-700');
    }

    // Filter categories
    function filterCategory(cat) {
        document.querySelectorAll('.cat-pill').forEach(btn => {
            btn.classList.remove('bg-[#7C3AED]', 'text-white', 'font-semibold');
            btn.classList.add('bg-slate-100', 'text-slate-600');
        });
        event.target.classList.remove('bg-slate-100', 'text-slate-600');
        event.target.classList.add('bg-[#7C3AED]', 'text-white', 'font-semibold');

        document.querySelectorAll('.product-item').forEach(el => {
            if (cat === 'all' || el.dataset.category === cat) {
                el.style.display = 'flex';
            } else {
                el.style.display = 'none';
            }
        });
    }

    // Live search
    document.getElementById('pos-search').addEventListener('input', function() {
        const term = this.value.toLowerCase();
        document.querySelectorAll('.product-item').forEach(el => {
            const name = el.dataset.name.toLowerCase();
            const sku = el.dataset.sku.toLowerCase();
            if (name.includes(term) || sku.includes(term)) {
                el.style.display = 'flex';
            } else {
                el.style.display = 'none';
            }
        });
    });
</script>
{% endblock %}
