{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Stock Movement History - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <a href="{{ path('app_inventory_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
            </a>
            <div>
                <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Stock Movement Audit Log</h1>
                <p class="text-slate-500 text-sm">Full chronological audit log of all stock-ins, sales deductions, and adjustments.</p>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="py-3 px-6">Timestamp</th>
                        <th class="py-3 px-4">Type</th>
                        <th class="py-3 px-4">Product</th>
                        <th class="py-3 px-4 text-center">Change</th>
                        <th class="py-3 px-4 text-center">Prev &rarr; New</th>
                        <th class="py-3 px-4">Reference Note</th>
                        <th class="py-3 px-6 text-right">User / Cashier</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    {% for m in movements %}
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3.5 px-6 text-slate-500 whitespace-nowrap">
                                {{ m.createdAt|date('M d, Y h:i:s A') }}
                            </td>
                            <td class="py-3.5 px-4">
                                {% if m.type == 'IN' %}
                                    <span class="inline-flex items-center gap-1 font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200">
                                        <i data-lucide="arrow-down-left" class="w-3 h-3"></i> IN
                                    </span>
                                {% elseif m.type == 'OUT' %}
                                    <span class="inline-flex items-center gap-1 font-bold text-rose-700 bg-rose-50 px-2.5 py-0.5 rounded-full border border-rose-200">
                                        <i data-lucide="arrow-up-right" class="w-3 h-3"></i> OUT
                                    </span>
                                {% else %}
                                    <span class="inline-flex items-center gap-1 font-bold text-indigo-700 bg-indigo-50 px-2.5 py-0.5 rounded-full border border-indigo-200">
                                        <i data-lucide="sliders" class="w-3 h-3"></i> ADJUST
                                    </span>
                                {% endif %}
                            </td>
                            <td class="py-3.5 px-4 font-semibold text-slate-800">
                                {{ m.product ? m.product.name : 'Unknown Product' }}
                            </td>
                            <td class="py-3.5 px-4 text-center font-bold {{ m.type == 'IN' ? 'text-emerald-600' : (m.type == 'OUT' ? 'text-rose-600' : 'text-indigo-600') }}">
                                {{ m.type == 'IN' ? '+' : (m.type == 'OUT' ? '-' : '±') }}{{ m.quantity }}
                            </td>
                            <td class="py-3.5 px-4 text-center text-slate-600 font-mono">
                                {{ m.previousQuantity }} &rarr; <span class="font-bold text-slate-900">{{ m.newQuantity }}</span>
                            </td>
                            <td class="py-3.5 px-4 text-slate-600">
                                {{ m.reference ?: 'System update' }}
                            </td>
                            <td class="py-3.5 px-6 text-right text-slate-500 font-medium">
                                {{ m.user ? (m.user.fullName ?: m.user.userIdentifier) : 'System' }}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="py-12 text-center text-slate-400">
                                No stock movements logged yet.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
