{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Inventory Monitoring - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header banner -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Inventory Management</h1>
            <p class="text-slate-500 text-sm">Monitor stock on hand, record incoming inventory, and track stock movements.</p>
        </div>

        <div class="flex items-center gap-3">
            <a href="{{ path('app_inventory_history') }}" class="py-2.5 px-4 bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 rounded-xl text-sm font-semibold flex items-center gap-2 shadow-sm transition-all">
                <i data-lucide="history" class="w-4 h-4 text-slate-500"></i>
                <span>Stock Movement Log</span>
            </a>
            <a href="{{ path('app_inventory_stock_in') }}" class="py-2.5 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold flex items-center gap-2 shadow-lg shadow-purple-600/30 transition-all">
                <i data-lucide="plus-circle" class="w-4 h-4"></i>
                <span>Stock In</span>
            </a>
        </div>
    </div>

    <!-- Inventory Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Total Units in Stock</span>
                <div class="text-3xl font-extrabold text-slate-900 mt-1 font-display">
                    {{ total_units|number_format(0, '.', ',') }}
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center">
                <i data-lucide="layers" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Low Stock Warnings</span>
                <div class="text-3xl font-extrabold text-amber-600 mt-1 font-display">
                    {{ low_stock_count }}
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-amber-50 text-amber-500 flex items-center justify-center">
                <i data-lucide="alert-triangle" class="w-6 h-6"></i>
            </div>
        </div>

        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
            <div>
                <span class="text-xs font-semibold uppercase tracking-wider text-slate-400">Out of Stock Items</span>
                <div class="text-3xl font-extrabold text-rose-600 mt-1 font-display">
                    {{ out_of_stock_count }}
                </div>
            </div>
            <div class="w-12 h-12 rounded-2xl bg-rose-50 text-rose-500 flex items-center justify-center">
                <i data-lucide="x-circle" class="w-6 h-6"></i>
            </div>
        </div>
    </div>

    <!-- Inventory List Table -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-slate-100 flex items-center justify-between">
            <h2 class="text-base font-bold text-slate-800 font-display">Stock Levels by Product</h2>
            <span class="text-xs text-slate-400">Sorted by lowest quantity first</span>
        </div>

        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="py-3 px-6">Product</th>
                        <th class="py-3 px-4">SKU</th>
                        <th class="py-3 px-4">Category</th>
                        <th class="py-3 px-4 text-center">Current Stock</th>
                        <th class="py-3 px-4 text-center">Min Level</th>
                        <th class="py-3 px-4 text-center">Status</th>
                        <th class="py-3 px-6 text-right">Quick Stock Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {% for p in products %}
                        <tr class="hover:bg-slate-50/70 transition-colors">
                            <td class="py-3.5 px-6">
                                <div class="flex items-center gap-3">
                                    <div class="w-10 h-10 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center text-base flex-shrink-0 overflow-hidden shadow-sm">
                                        {% if p.imagePath %}
                                            <img src="{{ asset('uploads/products/' ~ p.imagePath) }}" alt="{{ p.name }}" class="w-full h-full object-cover rounded-xl">
                                        {% elseif p.category == 'Snacks' %}🍿
                                        {% elseif p.category == 'Fruits' %}🍎
                                        {% elseif p.category == 'Canned Goods' %}🥫
                                        {% elseif p.category == 'Vegetables' %}🥕
                                        {% elseif p.category == 'Groceries' %}🛒
                                        {% else %}📦{% endif %}
                                    </div>
                                    <span class="font-semibold text-slate-800">{{ p.name }}</span>
                                </div>
                            </td>
                            <td class="py-3.5 px-4 text-xs font-mono text-slate-500">
                                {{ p.sku }}
                            </td>
                            <td class="py-3.5 px-4 text-xs text-slate-600 font-medium">
                                {{ p.category }}
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <span class="font-bold text-base {{ p.isLowStock ? 'text-amber-600' : (p.isOutOfStock ? 'text-rose-600' : 'text-slate-800') }}">
                                    {{ p.quantity }}
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-center text-xs text-slate-500">
                                {{ p.minStock }}
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                {% if p.isOutOfStock %}
                                    <span class="text-[11px] font-semibold text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full">Out of Stock</span>
                                {% elseif p.isLowStock %}
                                    <span class="text-[11px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-2 py-0.5 rounded-full">Low Stock</span>
                                {% else %}
                                    <span class="text-[11px] font-semibold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full">In Stock</span>
                                {% endif %}
                            </td>
                            <td class="py-3.5 px-6 text-right">
                                <div class="flex items-center justify-end gap-2">
                                    <a href="{{ path('app_inventory_stock_in', {'product_id': p.id}) }}" class="py-1 px-2.5 bg-purple-50 text-purple-700 hover:bg-purple-100 rounded-lg text-xs font-semibold flex items-center gap-1 transition-colors">
                                        <i data-lucide="plus" class="w-3.5 h-3.5"></i> Stock In
                                    </a>
                                    <a href="{{ path('app_inventory_adjust', {'id': p.id}) }}" class="py-1 px-2 bg-slate-100 text-slate-600 hover:bg-slate-200 rounded-lg text-xs font-medium transition-colors" title="Adjust Physical Count">
                                        <i data-lucide="sliders" class="w-3.5 h-3.5"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
