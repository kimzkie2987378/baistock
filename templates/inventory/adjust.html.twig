{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Adjust Stock - {{ product.name }}{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a href="{{ path('app_inventory_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Stock Adjustment</h1>
            <p class="text-slate-500 text-sm">Correct inventory discrepancies following physical count.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <div class="mb-5 pb-5 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 rounded-xl bg-purple-50 border border-purple-100 flex items-center justify-center overflow-hidden flex-shrink-0 shadow-sm">
                    {% if product.imagePath %}
                        <img src="{{ asset('uploads/products/' ~ product.imagePath) }}" alt="{{ product.name }}" class="w-full h-full object-cover rounded-xl">
                    {% else %}
                        <span class="text-xl">📦</span>
                    {% endif %}
                </div>
                <div>
                    <h3 class="font-bold text-slate-900 text-base">{{ product.name }}</h3>
                    <span class="text-xs text-purple-700 font-mono">{{ product.sku }} • {{ product.category }}</span>
                </div>
            </div>
            <div class="text-right">
                <span class="text-xs text-slate-400 block">Recorded Count</span>
                <span class="text-2xl font-extrabold text-slate-800">{{ product.quantity }}</span>
            </div>
        </div>

        <form action="{{ path('app_inventory_adjust', {'id': product.id}) }}" method="post" class="space-y-5">
            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Actual Physical Count (New Quantity) *</label>
                <input type="number" name="new_quantity" min="0" value="{{ product.quantity }}" required
                       class="w-full px-3.5 py-3 bg-slate-50 border border-slate-200 rounded-xl text-lg font-bold text-slate-900 focus:bg-white focus:outline-none focus:border-purple-600">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Reason for Adjustment *</label>
                <select name="reason" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    <option value="Physical count correction">Physical count correction</option>
                    <option value="Damaged / Expired goods">Damaged / Expired goods</option>
                    <option value="Internal store use">Internal store use</option>
                    <option value="Returned stock">Customer returned stock</option>
                    <option value="Other discrepancy">Other discrepancy</option>
                </select>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a href="{{ path('app_inventory_index') }}" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-colors">
                    Cancel
                </a>
                <button type="submit" class="py-2.5 px-6 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-lg shadow-purple-600/30 transition-all">
                    Update Count
                </button>
            </div>
        </form>
    </div>
</div>
{% endblock %}
