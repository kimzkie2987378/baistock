{% extends 'base.html.twig' %}

{% block title %}Log In - BaiStock Inventory Management{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center bg-[#F2F1F8] p-4 md:p-8">
    <div class="w-full max-w-5xl bg-white rounded-3xl shadow-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-2 border border-slate-100 min-h-[640px]">
        
        <!-- LEFT BRANDING PANEL -->
        <div class="relative bg-gradient-to-br from-[#F4F0FF] via-[#ECE5FF] to-[#E3D8FF] p-10 flex flex-col justify-between overflow-hidden">
            <!-- Background artistic curves -->
            <div class="absolute -top-24 -left-24 w-80 h-80 bg-purple-200/50 rounded-full blur-3xl pointer-events-none"></div>
            <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-indigo-200/40 rounded-full blur-3xl pointer-events-none"></div>

            <!-- Top Header & Logo -->
            <div class="relative z-10 text-center flex flex-col items-center">
                <div class="w-20 h-20 bg-white rounded-2xl shadow-xl flex items-center justify-center p-3 border border-purple-100 mb-4 transform hover:scale-105 transition-transform duration-300">
                    <img src="{{ asset('images/baistock-logo.jpg') }}" alt="BaiStock Logo" class="w-full h-full object-contain rounded-xl">
                </div>
                <h1 class="text-3xl font-display font-extrabold text-[#3B1261] tracking-tight">BaiStock</h1>
            </div>

            <!-- Headline & Tagline -->
            <div class="relative z-10 text-center my-6">
                <h2 class="text-2xl md:text-3xl font-bold text-slate-800 leading-snug tracking-tight">
                    Manage Your Inventory<br>
                    <span class="text-[#7C3AED]">Smarter, Easier, Faster.</span>
                </h2>
                <p class="text-slate-600 text-sm mt-3 max-w-sm mx-auto leading-relaxed">
                    Track your stock, organize your products, and grow your business — all in one place.
                </p>
            </div>

            <!-- 3D Illustration Graphics (Clipboard & Purple Box) -->
            <div class="relative z-10 flex items-center justify-center py-4">
                <div class="relative w-72 h-56 flex items-center justify-center">
                    <!-- Purple leaves background -->
                    <div class="absolute -left-4 bottom-8 text-purple-400/60 transform -rotate-12">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor">
                            <path d="M12 2C6.5 2 2 6.5 2 12c0 3.5 1.8 6.6 4.6 8.4C6.2 18.2 6 15.7 6 13c0-3.9 3.1-7 7-7 2.7 0 5.2.2 7.4.6C18.6 3.8 15.5 2 12 2z"/>
                        </svg>
                    </div>

                    <!-- Clipboard illustration -->
                    <div class="absolute left-6 bottom-4 w-36 h-44 bg-white rounded-2xl shadow-xl border-2 border-purple-200 transform -rotate-6 p-3 flex flex-col z-10">
                        <div class="w-10 h-3 bg-slate-300 rounded-full mx-auto mb-3"></div>
                        <div class="space-y-2.5">
                            <div class="flex items-center gap-2">
                                <div class="w-5 h-5 rounded-md bg-purple-600 flex items-center justify-center text-white text-xs font-bold">✓</div>
                                <div class="h-2 w-16 bg-slate-200 rounded"></div>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-5 h-5 rounded-md bg-purple-600 flex items-center justify-center text-white text-xs font-bold">✓</div>
                                <div class="h-2 w-20 bg-slate-200 rounded"></div>
                            </div>
                            <div class="flex items-center gap-2">
                                <div class="w-5 h-5 rounded-md bg-purple-600 flex items-center justify-center text-white text-xs font-bold">✓</div>
                                <div class="h-2 w-14 bg-slate-200 rounded"></div>
                            </div>
                        </div>
                    </div>

                    <!-- 3D Purple carton box illustration -->
                    <div class="absolute right-4 bottom-2 w-44 h-40 bg-gradient-to-tr from-[#6D28D9] via-[#8B5CF6] to-[#A78BFA] rounded-3xl shadow-2xl z-20 transform rotate-3 p-4 flex flex-col justify-between text-white border-t border-purple-300">
                        <!-- Top box tape -->
                        <div class="w-16 h-4 bg-purple-200/80 rounded mx-auto shadow-sm"></div>
                        <!-- Barcode label -->
                        <div class="bg-white/90 rounded-lg p-2 flex items-center justify-between w-28 ml-auto text-slate-800">
                            <div class="flex gap-0.5">
                                <span class="w-1 h-5 bg-slate-800"></span>
                                <span class="w-0.5 h-5 bg-slate-800"></span>
                                <span class="w-1.5 h-5 bg-slate-800"></span>
                                <span class="w-0.5 h-5 bg-slate-800"></span>
                                <span class="w-1 h-5 bg-slate-800"></span>
                            </div>
                            <span class="text-[9px] font-mono font-bold">BAI-01</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Footer microcopy -->
            <div class="relative z-10 text-center text-xs text-purple-700/60 font-medium">
                Offline Capable • Single PC or Local Network Ready
            </div>
        </div>

        <!-- RIGHT LOGIN FORM PANEL -->
        <div class="p-8 md:p-12 flex flex-col justify-center bg-white">
            <div class="max-w-md w-full mx-auto">
                <!-- Mobile Logo Header -->
                <div class="flex items-center justify-center gap-2 mb-6 text-center">
                    <div class="w-10 h-10 rounded-xl bg-purple-600 flex items-center justify-center p-1 text-white shadow-md">
                        <img src="{{ asset('images/baistock-logo.jpg') }}" alt="BaiStock" class="w-full h-full object-contain rounded-lg">
                    </div>
                    <span class="font-display font-bold text-2xl text-slate-900">BaiStock</span>
                </div>

                <div class="text-center mb-6">
                    <h2 class="text-2xl font-bold text-slate-900 tracking-tight">Welcome Back!</h2>
                    <p class="text-slate-500 text-sm mt-1">Log in to your account to continue.</p>
                </div>

                <!-- Error flash -->
                {% if error %}
                    <div class="mb-5 p-3.5 rounded-xl bg-rose-50 border border-rose-200 text-rose-700 text-sm flex items-center gap-2.5">
                        <i data-lucide="alert-circle" class="w-4 h-4 flex-shrink-0"></i>
                        <span>{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                    </div>
                {% endif %}

                <!-- Flash notices -->
                {% for message in app.flashes('success') %}
                    <div class="mb-5 p-3.5 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-700 text-sm flex items-center gap-2.5">
                        <i data-lucide="check-circle-2" class="w-4 h-4 flex-shrink-0"></i>
                        <span>{{ message }}</span>
                    </div>
                {% endfor %}

                <!-- Form -->
                <form action="{{ path('app_login') }}" method="post" class="space-y-4">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <!-- Username / Email Field -->
                    <div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="user" class="w-4 h-4"></i>
                            </div>
                            <input type="text" 
                                   name="_username" 
                                   id="username" 
                                   value="{{ last_username }}" 
                                   placeholder="Email or Username"
                                   required 
                                   autofocus
                                   class="w-full pl-10 pr-4 py-3 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-100 transition-all">
                        </div>
                    </div>

                    <!-- Password Field -->
                    <div>
                        <div class="relative">
                            <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                                <i data-lucide="lock" class="w-4 h-4"></i>
                            </div>
                            <input type="password" 
                                   name="_password" 
                                   id="password" 
                                   value=""
                                   placeholder="Password"
                                   required
                                   class="w-full pl-10 pr-11 py-3 bg-white border border-slate-200 rounded-xl text-sm text-slate-800 placeholder-slate-400 focus:outline-none focus:border-purple-600 focus:ring-2 focus:ring-purple-100 transition-all">
                            <button type="button" 
                                    id="toggle-password" 
                                    class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 focus:outline-none">
                                <i data-lucide="eye" id="eye-icon" class="w-4 h-4"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Remember me & Forgot Password -->
                    <div class="flex items-center justify-between text-sm pt-1">
                        <label class="flex items-center gap-2 cursor-pointer select-none text-slate-600">
                            <input type="checkbox" name="_remember_me" checked class="w-4 h-4 rounded text-purple-600 focus:ring-purple-500 border-slate-300">
                            <span>Remember me</span>
                        </label>
                        <a href="javascript:void(0)" onclick="alert('Contact the System Administrator to reset your password.')" class="text-purple-600 hover:text-purple-700 font-medium text-xs">
                            Forgot password?
                        </a>
                    </div>

                    <!-- Login Button -->
                    <button type="submit" 
                            class="w-full mt-2 py-3.5 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] text-white font-semibold rounded-xl shadow-lg shadow-purple-600/30 flex items-center justify-center gap-2 transition-all transform active:scale-[0.99]">
                        <span>Log In</span>
                        <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    </button>
                </form>

            </div>
        </div>
    </div>
</div>

<script>
    const toggleBtn = document.getElementById('toggle-password');
    const pwdInput = document.getElementById('password');
    if (toggleBtn && pwdInput) {
        toggleBtn.addEventListener('click', () => {
            const isPassword = pwdInput.type === 'password';
            pwdInput.type = isPassword ? 'text' : 'password';
            toggleBtn.innerHTML = isPassword 
                ? '<i data-lucide="eye-off" class="w-4 h-4"></i>' 
                : '<i data-lucide="eye" class="w-4 h-4"></i>';
            lucide.createIcons();
        });
    }
</script>
{% endblock %}
