{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Receipt {{ sale.receiptNumber }} - BaiStock{% endblock %}

{% block stylesheets %}
<style>
    @media print {
        body * {
            visibility: hidden;
        }
        #printable-receipt, #printable-receipt * {
            visibility: visible;
        }
        #printable-receipt {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            margin: 0;
            padding: 10px;
            box-shadow: none;
            border: none;
        }
        .no-print {
            display: none !important;
        }
    }
</style>
{% endblock %}

{% block content %}
<div class="max-w-md mx-auto space-y-6">
    <!-- Controls header -->
    <div class="flex items-center justify-between no-print">
        <a href="{{ path('app_receipts_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors flex items-center gap-1.5 text-xs font-semibold">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
            <span>Back to Receipts</span>
        </a>

        <div class="flex items-center gap-2">
            <a href="{{ path('app_sales_record') }}" class="py-2 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-semibold">
                New Sale
            </a>
            <button type="button" onclick="window.print()" class="py-2 px-4 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-xs font-semibold flex items-center gap-1.5 shadow-md shadow-purple-600/30">
                <i data-lucide="printer" class="w-3.5 h-3.5"></i>
                <span>Print Receipt</span>
            </button>
        </div>
    </div>

    <!-- THERMAL RECEIPT CARD -->
    <div id="printable-receipt" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-xl text-slate-800 font-mono text-xs">
        <!-- Store Header -->
        <div class="text-center pb-4 border-b border-dashed border-slate-300">
            <div class="w-12 h-12 mx-auto rounded-xl bg-purple-600 flex items-center justify-center p-1.5 mb-2 shadow-sm">
                <img src="{{ asset('images/baistock-logo.jpg') }}" alt="BaiStock" class="w-full h-full object-contain rounded-lg">
            </div>
            <h2 class="font-sans font-bold text-lg text-slate-900">{{ store_name }}</h2>
            <p class="text-[11px] text-slate-500 font-sans">{{ store_address }}</p>
            <p class="text-[11px] text-slate-500 font-sans">Tel: {{ store_contact }}</p>
        </div>

        <!-- Transaction Details -->
        <div class="py-3 border-b border-dashed border-slate-300 space-y-1 text-[11px]">
            <div class="flex justify-between">
                <span class="text-slate-500">Receipt No:</span>
                <span class="font-bold text-slate-800">{{ sale.receiptNumber }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">Date:</span>
                <span>{{ sale.createdAt|date('Y-m-d h:i A') }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">Cashier:</span>
                <span>{{ sale.cashierName }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">Payment:</span>
                <span>{{ sale.paymentMethod }}</span>
            </div>
        </div>

        <!-- Items Table -->
        <div class="py-3 border-b border-dashed border-slate-300">
            <div class="flex justify-between text-[11px] font-bold text-slate-600 pb-1.5">
                <span>ITEM</span>
                <span>QTY x PRICE</span>
                <span>TOTAL</span>
            </div>
            <div class="space-y-1.5 pt-1">
                {% for item in sale.items %}
                    <div class="flex justify-between items-start text-[11px]">
                        <div class="flex-1 pr-2">
                            <div class="font-semibold text-slate-800">{{ item.productName }}</div>
                            <div class="text-[10px] text-slate-400">{{ item.quantity }} @ ₱ {{ item.unitPrice|number_format(2, '.', ',') }}</div>
                        </div>
                        <div class="font-bold text-slate-900 whitespace-nowrap">
                            ₱ {{ item.totalPrice|number_format(2, '.', ',') }}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        <!-- Calculation Summary -->
        <div class="py-3 border-b border-dashed border-slate-300 space-y-1 text-[11px]">
            <div class="flex justify-between">
                <span class="text-slate-500">Subtotal:</span>
                <span>₱ {{ sale.subtotal|number_format(2, '.', ',') }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">VAT / Tax:</span>
                <span>₱ {{ sale.tax|number_format(2, '.', ',') }}</span>
            </div>
            <div class="flex justify-between text-sm font-bold text-slate-900 pt-1 border-t border-slate-200">
                <span>TOTAL:</span>
                <span>₱ {{ sale.totalAmount|number_format(2, '.', ',') }}</span>
            </div>
            <div class="flex justify-between pt-1">
                <span class="text-slate-500">Cash Tendered:</span>
                <span>₱ {{ sale.amountPaid|number_format(2, '.', ',') }}</span>
            </div>
            <div class="flex justify-between">
                <span class="text-slate-500">Change:</span>
                <span class="font-bold text-emerald-700">₱ {{ sale.changeAmount|number_format(2, '.', ',') }}</span>
            </div>
        </div>

        <!-- Seller Signature Section (Upper of Barcode for real-life signature after printing) -->
        <div class="pt-8 pb-2 text-center">
            <div class="w-48 mx-auto border-b-2 border-slate-900 mb-1.5"></div>
            <p class="text-[10px] uppercase font-bold tracking-wider text-slate-800">Seller Signature</p>
        </div>

        <!-- Barcode Graphic & Footer Note -->
        <div class="text-center pt-2 space-y-2">
            <div class="flex justify-center gap-1 my-2">
                <span class="w-1.5 h-8 bg-slate-900"></span>
                <span class="w-0.5 h-8 bg-slate-900"></span>
                <span class="w-2 h-8 bg-slate-900"></span>
                <span class="w-1 h-8 bg-slate-900"></span>
                <span class="w-0.5 h-8 bg-slate-900"></span>
                <span class="w-2.5 h-8 bg-slate-900"></span>
                <span class="w-1 h-8 bg-slate-900"></span>
                <span class="w-2 h-8 bg-slate-900"></span>
                <span class="w-0.5 h-8 bg-slate-900"></span>
                <span class="w-1.5 h-8 bg-slate-900"></span>
                <span class="w-1 h-8 bg-slate-900"></span>
                <span class="w-2.5 h-8 bg-slate-900"></span>
            </div>
            <p class="text-[10px] text-slate-400 font-mono">{{ sale.receiptNumber }}</p>
            <p class="text-xs font-semibold text-slate-700 pt-1">{{ footer_note }}</p>
            <p class="text-[9px] text-slate-400">Powered by BaiStock Local Inventory System</p>
        </div>
    </div>
</div>
{% endblock %}
