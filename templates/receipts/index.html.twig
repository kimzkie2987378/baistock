{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Receipts History - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">Receipts & Invoices</h1>
            <p class="text-slate-500 text-sm">Archived sales receipts for customer queries, audit, and printing.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm">
                <thead>
                    <tr class="bg-slate-50/80 border-b border-slate-100 text-xs font-semibold text-slate-500 uppercase tracking-wider">
                        <th class="py-3.5 px-6">Receipt #</th>
                        <th class="py-3.5 px-4">Date & Time</th>
                        <th class="py-3.5 px-4">Items Summary</th>
                        <th class="py-3.5 px-4 text-center">Payment</th>
                        <th class="py-3.5 px-4 text-right">Total Amount</th>
                        <th class="py-3.5 px-6 text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-xs">
                    {% for s in sales %}
                        <tr class="hover:bg-purple-50/50 transition-colors cursor-pointer group" onclick="window.location.href='{{ path('app_receipts_show', {'id': s.id}) }}'">
                            <td class="py-3.5 px-6 font-mono font-bold text-purple-700 group-hover:underline">
                                {{ s.receiptNumber }}
                            </td>
                            <td class="py-3.5 px-4 text-slate-500">
                                {{ s.createdAt|date('M d, Y h:i A') }}
                            </td>
                            <td class="py-3.5 px-4 font-semibold text-slate-800">
                                {{ s.primaryProductName }}
                            </td>
                            <td class="py-3.5 px-4 text-center">
                                <span class="bg-slate-100 text-slate-700 font-medium px-2 py-0.5 rounded-md">
                                    {{ s.paymentMethod }}
                                </span>
                            </td>
                            <td class="py-3.5 px-4 text-right font-extrabold text-slate-900 text-sm">
                                ₱ {{ s.totalAmount|number_format(2, '.', ',') }}
                            </td>
                            <td class="py-3.5 px-6 text-right">
                                <a href="{{ path('app_receipts_show', {'id': s.id}) }}" class="py-1.5 px-3 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-lg text-xs font-semibold inline-flex items-center gap-1.5 shadow-sm shadow-purple-600/20 transition-all">
                                    <i data-lucide="receipt" class="w-3.5 h-3.5"></i>
                                    <span>Show Full Receipt</span>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="py-12 text-center text-slate-400">
                                No receipts recorded yet.
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
