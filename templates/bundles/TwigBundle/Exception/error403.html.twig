{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}403 Forbidden - Access Denied{% endblock %}

{% block content %}
<div class="min-h-[70vh] flex items-center justify-center">
    <div class="bg-white rounded-3xl p-10 max-w-lg w-full text-center border border-slate-200/80 shadow-xl space-y-5 animate-fadeIn">
        <div class="w-20 h-20 bg-rose-50 border border-rose-200 rounded-3xl text-rose-600 flex items-center justify-center mx-auto shadow-inner">
            <i data-lucide="shield-alert" class="w-10 h-10"></i>
        </div>
        
        <div>
            <span class="px-3 py-1 bg-rose-100 text-rose-700 font-mono font-bold text-xs rounded-full uppercase tracking-wider">HTTP 403 Forbidden</span>
            <h1 class="text-2xl font-bold font-display text-slate-800 mt-3">Access Restricted</h1>
            <p class="text-slate-500 text-sm mt-2 leading-relaxed">
                Your account (<span class="font-bold text-slate-700">{{ app.user ? app.user.userIdentifier : 'Staff' }}</span>) is assigned the <span class="font-bold text-purple-700">STAFF</span> role. This module (<code class="bg-slate-100 px-2 py-0.5 rounded text-xs text-rose-600 font-mono">/staff</code>) requires <span class="font-bold text-rose-600">ROLE_ADMIN</span> or <span class="font-bold text-rose-600">ROLE_OWNER</span> privileges.
            </p>
        </div>

        <div class="pt-4 border-t border-slate-100 flex items-center justify-center gap-3">
            <a href="{{ path('app_dashboard') }}" class="py-2.5 px-5 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-md shadow-purple-600/30 transition-all flex items-center gap-2">
                <i data-lucide="arrow-left" class="w-4 h-4"></i>
                <span>Return to Dashboard</span>
            </a>
            <a href="{{ path('app_sales_record') }}" class="py-2.5 px-5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-all flex items-center gap-2">
                <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                <span>Open POS</span>
            </a>
        </div>
    </div>
</div>
{% endblock %}
