{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Settings - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">
    <div>
        <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">System & Store Settings</h1>
        <p class="text-slate-500 text-sm">Configure store identity, receipts, database backup, and admin credentials.</p>
    </div>

    <!-- Admin Account Security (Only visible to Admin) -->
    {% if is_granted('ROLE_ADMIN') %}
    <div class="bg-white rounded-2xl border-2 border-purple-200/90 shadow-sm p-6 md:p-8">
        <div class="flex items-center gap-2.5 mb-5 pb-4 border-b border-slate-100">
            <div class="p-2 bg-purple-100 text-[#7C3AED] rounded-xl">
                <i data-lucide="shield-check" class="w-5 h-5"></i>
            </div>
            <div>
                <h2 class="text-base font-bold text-slate-800 font-display">Administrator Security & Credentials</h2>
                <p class="text-xs text-slate-400">Change the administrator username, email, and login password. (Admin Only)</p>
            </div>
        </div>

        <form action="{{ path('app_settings_update_admin') }}" method="post" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Admin Username</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="at-sign" class="w-4 h-4"></i>
                        </div>
                        <input type="text" name="admin_username" value="{{ app.user.username }}" required
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Admin Email Address</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="mail" class="w-4 h-4"></i>
                        </div>
                        <input type="email" name="admin_email" value="{{ app.user.email }}" required
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">New Password (Optional)</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </div>
                        <input type="password" name="admin_password" placeholder="Leave blank to keep current password"
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Confirm New Password</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </div>
                        <input type="password" name="confirm_password" placeholder="Repeat new password"
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                    </div>
                </div>
            </div>

            <div class="pt-3 border-t border-slate-100 flex justify-end">
                <button type="submit" class="py-2.5 px-6 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-lg shadow-purple-600/30 transition-all flex items-center gap-2">
                    <i data-lucide="save" class="w-4 h-4"></i>
                    <span>Update Admin Credentials</span>
                </button>
            </div>
        </form>
    </div>
    {% endif %}

    <!-- Store Profile & Preferences -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <div class="flex items-center gap-2.5 mb-5 pb-4 border-b border-slate-100">
            <div class="p-1.5 bg-purple-100 text-[#7C3AED] rounded-lg">
                <i data-lucide="store" class="w-4 h-4"></i>
            </div>
            <div>
                <h2 class="text-base font-bold text-slate-800 font-display">Store Information</h2>
                <p class="text-xs text-slate-400">Printed on thermal receipts and displayed on customer invoices.</p>
            </div>
        </div>

        <form action="{{ path('app_settings_index') }}" method="post" class="space-y-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Store / Business Name</label>
                    <input type="text" name="store_name" value="{{ settings.store_name }}" required
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 font-medium">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Contact Number</label>
                    <input type="text" name="store_contact" value="{{ settings.store_contact }}" required
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Store Address</label>
                <input type="text" name="store_address" value="{{ settings.store_address }}" required
                       class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Currency Symbol</label>
                    <input type="text" name="currency_symbol" value="{{ settings.currency_symbol }}" required
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Default Low Stock Reorder Threshold</label>
                    <input type="number" name="default_min_stock" min="1" value="{{ settings.default_min_stock }}" required
                           class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-600 uppercase mb-1">Receipt Footer Note</label>
                <input type="text" name="receipt_footer" value="{{ settings.receipt_footer }}"
                       class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600">
            </div>

            <div class="pt-3 border-t border-slate-100 flex justify-end">
                <button type="submit" class="py-2.5 px-6 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-lg shadow-purple-600/30 transition-all">
                    Save Store Settings
                </button>
            </div>
        </form>
    </div>

    <!-- Backup & Data Integrity -->
    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <div class="flex items-center gap-2.5 mb-5 pb-4 border-b border-slate-100">
            <div class="p-1.5 bg-blue-100 text-blue-700 rounded-lg">
                <i data-lucide="database" class="w-4 h-4"></i>
            </div>
            <div>
                <h2 class="text-base font-bold text-slate-800 font-display">Database & Data Integrity</h2>
                <p class="text-xs text-slate-400">Offline database backup and JSON export.</p>
            </div>
        </div>

        <div class="p-4 rounded-xl border border-slate-200 bg-slate-50/70 flex flex-col sm:flex-row items-center justify-between gap-4">
            <div>
                <h3 class="font-bold text-sm text-slate-800">Export System Backup (JSON)</h3>
                <p class="text-xs text-slate-500 mt-1">Download complete catalog and sales records to a portable JSON backup file.</p>
            </div>
            <div>
                <a href="{{ path('app_settings_backup_export') }}" class="py-2.5 px-4 bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 font-semibold text-xs rounded-xl inline-flex items-center justify-center gap-1.5 shadow-sm transition-colors whitespace-nowrap">
                    <i data-lucide="download" class="w-4 h-4"></i>
                    <span>Download Backup</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Technical System Specs -->
    <div class="bg-slate-50 rounded-2xl border border-slate-200 p-5 text-xs text-slate-600 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
            <span class="font-semibold text-slate-800">BaiStock Storage Management v1.0.0</span>
            <span class="text-slate-400">•</span>
            <span>PHP {{ constant('PHP_VERSION') }}</span>
            <span class="text-slate-400">•</span>
            <span>Symfony 8.1.11</span>
            <span class="text-slate-400">•</span>
            <span>MySQL 8.0 Database</span>
        </div>
        <div class="text-slate-400">
            Icons by Lucide • Built for Small Businesses & Sari-sari Stores
        </div>
    </div>
</div>
{% endblock %}
