{% extends 'layout/dashboard_layout.html.twig' %}

{% block title %}Create Delivery Order - BaiStock Storage Management{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto space-y-6">
    <div class="flex items-center gap-3">
        <a href="{{ path('app_delivery_index') }}" class="p-2 bg-white border border-slate-200 hover:bg-slate-50 rounded-xl text-slate-600 transition-colors">
            <i data-lucide="arrow-left" class="w-4 h-4"></i>
        </a>
        <div>
            <h1 class="text-2xl font-bold font-display text-slate-800 tracking-tight">New Supplier Delivery</h1>
            <p class="text-slate-500 text-sm">Log an incoming shipment with itemized products and costs.</p>
        </div>
    </div>

    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm p-6 md:p-8">
        <form action="{{ path('app_delivery_new') }}" method="post" id="delivery-form" class="space-y-6">
            
            <!-- 1. SUPPLIER NAME -->
            <div>
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">1. Supplier Name *</label>
                <div class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="building-2" class="w-4 h-4"></i>
                    </div>
                    <input type="text" name="supplier" required placeholder="e.g. San Miguel Beverages Inc."
                           class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 transition-all">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                <!-- 2. TRACKING NUMBER -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">2. Tracking / PO Number</label>
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="hash" class="w-4 h-4"></i>
                        </div>
                        <input type="text" name="trackingNumber" placeholder="Auto-generated if empty"
                               class="w-full pl-10 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-mono text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 transition-all">
                    </div>
                </div>

                <!-- 3. DELIVERY STATUS -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">3. Delivery Status *</label>
                    <select name="status" id="delivery-status" class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-semibold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 transition-all">
                        <option value="Pending">Pending (Not received yet)</option>
                        <option value="In Transit">In Transit (On the way)</option>
                        <option value="Delivered">Delivered (Auto-adds to inventory)</option>
                    </select>
                </div>

                <!-- 4. TOTAL COST -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">4. Total Cost (₱)</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 font-bold">₱</span>
                        <input type="number" name="totalCost" id="total-cost-input" step="0.25" min="0" placeholder="0.00"
                               class="w-full pl-8 pr-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm font-bold text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 transition-all">
                    </div>
                    <p class="text-[10px] text-slate-400 mt-1">Calculates automatically from items or enter custom amount.</p>
                </div>
            </div>

            <!-- 5. DELIVERY ITEMS (PRODUCTS WITHOUT PICTURES) -->
            <div class="border-t border-slate-100 pt-5 space-y-3">
                <div class="flex items-center justify-between">
                    <div>
                        <label class="block text-xs font-bold text-slate-800 uppercase tracking-wider">5. Delivery Items (Products)</label>
                        <p class="text-xs text-slate-500">Add products to this shipment (without pictures). Stock is updated when marked received.</p>
                    </div>
                    <button type="button" onclick="addDeliveryItemRow()" class="py-2 px-3.5 bg-purple-50 hover:bg-purple-100 text-[#7C3AED] rounded-xl text-xs font-bold inline-flex items-center gap-1.5 transition-colors border border-purple-200 shadow-sm">
                        <i data-lucide="plus" class="w-4 h-4"></i>
                        <span>Add Product</span>
                    </button>
                </div>

                <!-- Product Items Table -->
                <div class="bg-[#F8F9FC] border border-slate-200/90 rounded-2xl overflow-hidden p-4">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs" id="delivery-items-table">
                            <thead>
                                <tr class="text-slate-500 font-semibold border-b border-slate-200 pb-2">
                                    <th class="pb-2.5 pl-2 text-left">Product</th>
                                    <th class="pb-2.5 text-center w-32">Quantity</th>
                                    <th class="pb-2.5 text-right w-36">Unit Cost (₱)</th>
                                    <th class="pb-2.5 text-right w-36">Subtotal (₱)</th>
                                    <th class="pb-2.5 text-center w-14"></th>
                                </tr>
                            </thead>
                            <tbody id="delivery-items-body" class="divide-y divide-slate-200/70">
                                <!-- Populated dynamically by JS -->
                            </tbody>
                        </table>
                    </div>

                    <div id="no-items-placeholder" class="py-6 text-center text-slate-400">
                        <i data-lucide="package-search" class="w-8 h-8 mx-auto text-slate-300 mb-1.5"></i>
                        <p class="font-medium text-slate-600 text-xs">No products added to this delivery yet.</p>
                        <button type="button" onclick="addDeliveryItemRow()" class="mt-2 text-xs font-bold text-[#7C3AED] hover:underline">
                            + Click here to add your first product
                        </button>
                    </div>
                </div>
            </div>

            <!-- 6. DELIVERY NOTES (UNDER THE ITEMS) -->
            <div class="border-t border-slate-100 pt-5">
                <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1">6. Delivery Notes</label>
                <textarea name="notes" rows="3" placeholder="Enter any supplier details, batch numbers, remarks, or packaging conditions..."
                          class="w-full px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:outline-none focus:border-purple-600 transition-all"></textarea>
            </div>

            <!-- ACTION BUTTONS -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a href="{{ path('app_delivery_index') }}" class="py-2.5 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-sm font-semibold transition-colors">
                    Cancel
                </a>
                <button type="submit" class="py-2.5 px-6 bg-[#7C3AED] hover:bg-[#6D28D9] text-white rounded-xl text-sm font-semibold shadow-lg shadow-purple-600/30 transition-all flex items-center gap-2">
                    <i data-lucide="check" class="w-4 h-4"></i>
                    <span>Save Delivery Order</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Product Options Template -->
<template id="product-options-template">
    <option value="">-- Choose Product --</option>
    {% for p in products %}
        <option value="{{ p.id }}" data-price="{{ p.price }}" data-stock="{{ p.quantity }}">
            {{ p.name }} (SKU: {{ p.sku }}) — Current Stock: {{ p.quantity }}
        </option>
    {% endfor %}
</template>

<script>
    let rowIndex = 0;

    function addDeliveryItemRow() {
        const tbody = document.getElementById('delivery-items-body');
        const placeholder = document.getElementById('no-items-placeholder');
        if (placeholder) placeholder.classList.add('hidden');

        const optionsHtml = document.getElementById('product-options-template').innerHTML;

        const tr = document.createElement('tr');
        tr.className = 'item-row hover:bg-white/80 transition-colors';
        tr.id = 'row-' + rowIndex;

        tr.innerHTML = `
            <td class="py-2.5 pl-2 pr-2">
                <select name="item_product_id[]" required onchange="handleProductSelect(this, ${rowIndex})"
                        class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:outline-none focus:border-purple-600">
                    ${optionsHtml}
                </select>
            </td>
            <td class="py-2.5 px-2 text-center">
                <input type="number" name="item_quantity[]" min="1" value="1" required oninput="recalcRow(${rowIndex})"
                       class="w-24 text-center px-2 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:outline-none focus:border-purple-600">
            </td>
            <td class="py-2.5 px-2 text-right">
                <div class="relative">
                    <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center text-slate-400 font-bold text-xs">₱</span>
                    <input type="number" name="item_cost[]" step="0.25" min="0" value="0.00" required oninput="recalcRow(${rowIndex})"
                           class="w-32 pl-6 pr-2 py-2 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-800 text-right focus:outline-none focus:border-purple-600">
                </div>
            </td>
            <td class="py-2.5 px-2 text-right">
                <span class="font-extrabold text-xs text-slate-900 row-subtotal" id="subtotal-${rowIndex}">₱ 0.00</span>
            </td>
            <td class="py-2.5 px-2 text-center">
                <button type="button" onclick="removeRow(${rowIndex})" class="p-1.5 text-slate-400 hover:text-rose-600 hover:bg-rose-50 rounded-lg transition-colors" title="Remove Item">
                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                </button>
            </td>
        `;

        tbody.appendChild(tr);
        lucide.createIcons();
        rowIndex++;
        recalcTotalCost();
    }

    function handleProductSelect(selectEl, idx) {
        const selectedOpt = selectEl.options[selectEl.selectedIndex];
        const row = document.getElementById('row-' + idx);
        if (!row) return;

        const costInput = row.querySelector('input[name="item_cost[]"]');
        if (costInput && selectedOpt && selectedOpt.dataset.price) {
            // Suggest selling price as default unit cost reference if 0
            if (parseFloat(costInput.value) <= 0) {
                costInput.value = parseFloat(selectedOpt.dataset.price).toFixed(2);
            }
        }
        recalcRow(idx);
    }

    function recalcRow(idx) {
        const row = document.getElementById('row-' + idx);
        if (!row) return;

        const qtyInput = row.querySelector('input[name="item_quantity[]"]');
        const costInput = row.querySelector('input[name="item_cost[]"]');
        const subtotalEl = document.getElementById('subtotal-' + idx);

        const qty = parseFloat(qtyInput.value) || 0;
        const cost = parseFloat(costInput.value) || 0;
        const subtotal = qty * cost;

        if (subtotalEl) {
            subtotalEl.textContent = '₱ ' + subtotal.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2});
        }
        recalcTotalCost();
    }

    function removeRow(idx) {
        const row = document.getElementById('row-' + idx);
        if (row) {
            row.remove();
        }
        const remaining = document.querySelectorAll('#delivery-items-body tr');
        if (remaining.length === 0) {
            const placeholder = document.getElementById('no-items-placeholder');
            if (placeholder) placeholder.classList.remove('hidden');
        }
        recalcTotalCost();
    }

    function recalcTotalCost() {
        let total = 0;
        const rows = document.querySelectorAll('#delivery-items-body tr');
        rows.forEach(row => {
            const qty = parseFloat(row.querySelector('input[name="item_quantity[]"]')?.value) || 0;
            const cost = parseFloat(row.querySelector('input[name="item_cost[]"]')?.value) || 0;
            total += qty * cost;
        });

        const totalCostInput = document.getElementById('total-cost-input');
        if (totalCostInput && total > 0) {
            totalCostInput.value = total.toFixed(2);
        }
    }

    // Add first item row automatically on load
    document.addEventListener('DOMContentLoaded', () => {
        addDeliveryItemRow();
    });
</script>
{% endblock %}
