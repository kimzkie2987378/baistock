{% extends 'base.html.twig' %}

{% block body %}
{% set notifs = get_notifications() %}
<div class="flex h-screen overflow-hidden bg-[#F5F6FA]">
    <!-- SIDEBAR (Fixed, no scroll, no box watermark) -->
    <aside class="w-64 flex-shrink-0 bg-[#190933] text-white flex flex-col justify-between h-full relative shadow-xl z-20 overflow-hidden select-none">
        <!-- Top branding & nav -->
        <div class="flex flex-col flex-1 overflow-hidden">
            <!-- BaiStock Logo Header -->
            <div class="px-6 py-5 flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#6D28D9] to-[#8B5CF6] flex items-center justify-center shadow-lg shadow-purple-900/40 p-1.5 flex-shrink-0">
                    <img src="{{ asset('images/baistock-logo.jpg') }}" alt="BaiStock" class="w-full h-full object-contain rounded-lg">
                </div>
                <div class="flex flex-col">
                    <span class="font-display font-bold text-2xl tracking-tight text-white leading-none">BaiStock</span>
                    <span class="text-[10px] uppercase font-semibold tracking-wider text-purple-300/70 mt-1">Storage Management</span>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="px-3 py-1 space-y-0.5 overflow-hidden">
                {% set current_route = app.request.attributes.get('_route') %}

                <a href="{{ path('app_dashboard') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route == 'app_dashboard' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="layout-dashboard" class="w-4 h-4"></i>
                    <span>Dashboard</span>
                </a>

                <a href="{{ path('app_product_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_product' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="package" class="w-4 h-4"></i>
                    <span>Products</span>
                </a>

                <a href="{{ path('app_inventory_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_inventory' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="database" class="w-4 h-4"></i>
                    <span>Inventory</span>
                </a>

                <a href="{{ path('app_sales_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_sales' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="shopping-cart" class="w-4 h-4"></i>
                    <span>Sales</span>
                </a>

                <a href="{{ path('app_delivery_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_delivery' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="truck" class="w-4 h-4"></i>
                    <span>Delivery</span>
                </a>

                <a href="{{ path('app_reports_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_reports' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                    <span>Reports</span>
                </a>

                {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_OWNER') %}
                <a href="{{ path('app_staff_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_staff' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="user-check" class="w-4 h-4"></i>
                    <span>Staff</span>
                </a>
                {% endif %}

                <a href="{{ path('app_settings_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_settings' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="settings" class="w-4 h-4"></i>
                    <span>Settings</span>
                </a>

                <a href="{{ path('app_receipts_index') }}" 
                   class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_receipts' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <i data-lucide="receipt" class="w-4 h-4"></i>
                    <span>Receipts</span>
                </a>

                <a href="{{ path('app_notifications_index') }}" 
                   class="flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium transition-all duration-200 {{ current_route starts with 'app_notifications' ? 'bg-[#7C3AED] text-white shadow-md shadow-purple-900/50 font-semibold' : 'text-purple-200/80 hover:bg-white/5 hover:text-white' }}">
                    <div class="flex items-center gap-3">
                        <i data-lucide="bell" class="w-4 h-4"></i>
                        <span>Notifications</span>
                    </div>
                    {% if notifs.unread_count > 0 %}
                        <span id="sidebar-notif-badge" class="px-2 py-0.5 text-[10px] font-bold rounded-full bg-rose-500 text-white shadow-sm">
                            {{ notifs.unread_count > 99 ? '99+' : notifs.unread_count }}
                        </span>
                    {% endif %}
                </a>
            </nav>
        </div>

        <!-- Bottom Logout (Box design removed) -->
        <div class="p-4 border-t border-white/5">
            <a href="{{ path('app_logout') }}" 
               class="flex items-center gap-3 px-4 py-2 rounded-xl text-sm font-medium text-purple-200/70 hover:text-white hover:bg-white/10 transition-colors">
                <i data-lucide="log-out" class="w-4 h-4"></i>
                <span>Logout</span>
            </a>
        </div>
    </aside>

    <!-- MAIN WRAPPER -->
    <div class="flex-1 flex flex-col min-w-0 overflow-hidden">
        <!-- TOP HEADER BAR -->
        <header class="h-16 bg-white border-b border-slate-200/80 px-6 flex items-center justify-between flex-shrink-0 z-10">
            <!-- Search bar -->
            <div class="relative w-96">
                <form action="{{ path('app_product_index') }}" method="get" class="relative">
                    <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                        <i data-lucide="search" class="w-4 h-4"></i>
                    </div>
                    <input type="text" 
                           name="q" 
                           value="{{ app.request.query.get('q') }}"
                           placeholder="Search products, categories..." 
                           class="w-full pl-10 pr-4 py-2 bg-[#F6F8FC] border border-transparent rounded-xl text-sm text-slate-700 placeholder-slate-400 focus:bg-white focus:border-purple-500 focus:ring-2 focus:ring-purple-200 focus:outline-none transition-all">
                </form>
            </div>

            <!-- Right header items: Notifications & Profile -->
            <div class="flex items-center gap-4">
                <!-- Notifications icon with live dynamic badge -->
                <div class="relative" id="notif-dropdown-wrapper">
                    <button type="button" 
                            id="notif-btn" 
                            class="p-2 text-slate-500 hover:text-purple-600 hover:bg-purple-50 rounded-xl relative transition-colors"
                            title="Notifications ({{ notifs.unread_count }} alerts)">
                        <i data-lucide="bell" class="w-5 h-5"></i>
                        {% if notifs.unread_count > 0 %}
                            <span id="notif-badge" class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 bg-rose-600 text-white text-[10px] font-bold rounded-full flex items-center justify-center border-2 border-white shadow-sm animate-pulse">
                                {{ notifs.unread_count > 9 ? '9+' : notifs.unread_count }}
                            </span>
                        {% endif %}
                    </button>
                    <!-- Notification popup -->
                    <div id="notif-popup" class="hidden absolute right-0 mt-2 w-80 sm:w-96 bg-white rounded-3xl shadow-2xl border border-slate-100 py-3 px-4 z-50 text-xs">
                        <!-- Popup Header -->
                        <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-2">
                            <div class="flex items-center gap-2">
                                <span class="font-bold text-sm text-slate-800 font-display">Notifications</span>
                                <span id="notif-header-count" class="px-2 py-0.5 rounded-full text-[10px] font-bold {{ notifs.unread_count > 0 ? 'bg-purple-100 text-purple-700' : 'bg-slate-100 text-slate-600' }}">
                                    {{ notifs.unread_count }} unread
                                </span>
                            </div>
                            {% if notifs.unread_count > 0 %}
                                <form method="post" action="{{ path('app_notifications_mark_all_read') }}" class="inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('mark_all_notifications_read') }}">
                                    <button type="submit" class="text-[11px] font-semibold text-purple-600 hover:text-purple-800 hover:underline">
                                        Mark all as read
                                    </button>
                                </form>
                            {% endif %}
                        </div>

                        <!-- Filter Tabs -->
                        {% if notifs.total_count > 0 %}
                            <div class="flex items-center gap-1 mb-2 bg-slate-50 p-1 rounded-xl text-[11px]">
                                <button type="button" onclick="filterNotifs('all')" class="notif-tab flex-1 py-1 rounded-lg font-bold bg-white text-purple-700 shadow-xs" data-target="all">
                                    All ({{ notifs.total_count }})
                                </button>
                                <button type="button" onclick="filterNotifs('stock')" class="notif-tab flex-1 py-1 rounded-lg font-medium text-slate-500 hover:text-slate-800" data-target="stock">
                                    Stock ({{ notifs.low_stock_count + notifs.out_of_stock_count }})
                                </button>
                                <button type="button" onclick="filterNotifs('delivery')" class="notif-tab flex-1 py-1 rounded-lg font-medium text-slate-500 hover:text-slate-800" data-target="delivery">
                                    Deliveries ({{ notifs.pending_delivery_count }})
                                </button>
                            </div>
                        {% endif %}

                        <!-- Notification Items List -->
                        <div id="notif-items-list" class="max-h-80 overflow-y-auto divide-y divide-slate-100 pr-0.5">
                            {% for item in notifs.items %}
                                <div class="py-2.5 notif-item transition-colors hover:bg-slate-50/80 rounded-xl px-2" data-type="{{ item.type == 'delivery' ? 'delivery' : 'stock' }}">
                                    <div class="flex items-start gap-3">
                                        <div class="w-8 h-8 rounded-xl {{ item.icon_bg }} flex items-center justify-center flex-shrink-0 mt-0.5">
                                            <i data-lucide="{{ item.icon }}" class="w-4 h-4"></i>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex items-center justify-between gap-1 mb-0.5">
                                                <h4 class="font-bold text-slate-800 truncate text-xs">{{ item.title }}</h4>
                                                <span class="text-[9px] px-1.5 py-0.5 rounded-full font-bold whitespace-nowrap {{ item.badge_class }}">
                                                    {{ item.badge }}
                                                </span>
                                            </div>
                                            <p class="text-[11px] text-slate-500 line-clamp-2 leading-relaxed">{{ item.message }}</p>
                                            <div class="mt-1.5 flex items-center justify-between">
                                                <span class="text-[10px] text-slate-400 font-medium">{{ item.timestamp }}</span>
                                                <a href="{{ item.url }}" class="inline-flex items-center gap-1 font-bold text-[11px] text-[#7C3AED] hover:text-[#6D28D9] hover:underline">
                                                    <span>{{ item.action_text }}</span>
                                                    <i data-lucide="chevron-right" class="w-3 h-3"></i>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="py-8 text-center text-slate-400">
                                    <div class="w-10 h-10 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center mx-auto mb-2 border border-emerald-100">
                                        <i data-lucide="check" class="w-5 h-5"></i>
                                    </div>
                                    <p class="font-bold text-slate-700 text-xs">All caught up!</p>
                                    <p class="text-[11px] text-slate-400 mt-0.5">No active inventory warnings or pending shipments.</p>
                                </div>
                            {% endfor %}
                        </div>

                        <!-- Popup Footer Quick Links -->
                        <div class="border-t border-slate-100 pt-2.5 mt-1 flex items-center justify-between text-[11px]">
                            <a href="{{ path('app_notifications_index') }}" class="font-bold text-purple-600 hover:underline flex items-center gap-1">
                                <i data-lucide="bell" class="w-3.5 h-3.5"></i>
                                <span>All Notifications Log &rarr;</span>
                            </a>
                            <a href="{{ path('app_delivery_index') }}" class="font-semibold text-slate-600 hover:text-purple-600 hover:underline flex items-center gap-1">
                                <i data-lucide="truck" class="w-3.5 h-3.5"></i>
                                <span>Deliveries</span>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- User profile dropdown -->
                <div class="relative" id="user-menu-wrapper">
                    <button type="button" 
                            id="user-menu-btn"
                            class="flex items-center gap-3 pl-2 pr-1 py-1 rounded-xl hover:bg-slate-50 transition-colors">
                        <div class="w-9 h-9 rounded-full bg-gradient-to-tr from-purple-600 to-indigo-600 text-white flex items-center justify-center font-bold text-sm shadow-sm">
                            {{ app.user ? app.user.userIdentifier|slice(0, 1)|upper : 'A' }}
                        </div>
                        <div class="text-left hidden md:block">
                            <span class="block text-sm font-semibold text-slate-700 leading-tight">
                                {{ app.user ? (app.user.fullName ?: app.user.userIdentifier) : 'Admin' }}
                            </span>
                            <span class="block text-[11px] font-medium text-purple-600">
                                {{ app.user ? app.user.roleLabel : 'Administrator' }}
                            </span>
                        </div>
                        <i data-lucide="chevron-down" class="w-4 h-4 text-slate-400"></i>
                    </button>
                    <!-- User popup menu -->
                    <div id="user-menu-popup" class="hidden absolute right-0 mt-2 w-52 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                        <div class="px-4 py-2 border-b border-slate-100">
                            <p class="text-xs text-slate-400">Signed in as</p>
                            <p class="text-sm font-semibold text-slate-800 truncate">{{ app.user ? app.user.email : 'admin@baistock.ph' }}</p>
                        </div>
                        <a href="{{ path('app_settings_index') }}" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                            <i data-lucide="settings" class="w-4 h-4"></i> Settings
                        </a>
                        {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('app_staff_index') }}" class="flex items-center gap-2.5 px-4 py-2 text-sm text-slate-700 hover:bg-purple-50 hover:text-purple-700">
                            <i data-lucide="user-check" class="w-4 h-4"></i> Staff Accounts
                        </a>
                        {% endif %}
                        <div class="border-t border-slate-100 my-1"></div>
                        <a href="{{ path('app_logout') }}" class="flex items-center gap-2.5 px-4 py-2 text-sm text-red-600 hover:bg-red-50">
                            <i data-lucide="log-out" class="w-4 h-4"></i> Sign Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- FLASH MESSAGES -->
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="mx-6 mt-4 p-4 rounded-xl flex items-center justify-between text-sm shadow-sm transition-all animate-fadeIn
                    {{ label == 'success' ? 'bg-emerald-50 text-emerald-800 border border-emerald-200' : '' }}
                    {{ label == 'error' or label == 'danger' ? 'bg-rose-50 text-rose-800 border border-rose-200' : '' }}
                    {{ label == 'warning' ? 'bg-amber-50 text-amber-800 border border-amber-200' : '' }}
                    {{ label == 'info' ? 'bg-blue-50 text-blue-800 border border-blue-200' : '' }}">
                    <div class="flex items-center gap-3">
                        {% if label == 'success' %}
                            <i data-lucide="check-circle-2" class="w-5 h-5 text-emerald-600"></i>
                        {% elseif label == 'error' or label == 'danger' %}
                            <i data-lucide="alert-circle" class="w-5 h-5 text-rose-600"></i>
                        {% else %}
                            <i data-lucide="info" class="w-5 h-5 text-amber-600"></i>
                        {% endif %}
                        <span class="font-medium">{{ message }}</span>
                    </div>
                    <button type="button" onclick="this.parentElement.remove()" class="text-slate-400 hover:text-slate-600">
                        <i data-lucide="x" class="w-4 h-4"></i>
                    </button>
                </div>
            {% endfor %}
        {% endfor %}

        <!-- MAIN SCROLLABLE CONTENT -->
        <main class="flex-1 overflow-y-auto p-6 md:p-8">
            {% block content %}{% endblock %}
        </main>
    </div>
</div>

<script>
    // Header dropdown toggles
    const notifBtn = document.getElementById('notif-btn');
    const notifPopup = document.getElementById('notif-popup');
    const notifBadge = document.getElementById('notif-badge');
    const markReadBtn = document.getElementById('notif-mark-read-btn');

    if (notifBtn && notifPopup) {
        notifBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            const isOpening = notifPopup.classList.contains('hidden');
            notifPopup.classList.toggle('hidden');
            if (isOpening && window.lucide) {
                lucide.createIcons();
            }
        });

        // Don't close when clicking inside the popup
        notifPopup.addEventListener('click', (e) => {
            e.stopPropagation();
        });
    }

    // Mark as read handler
    if (markReadBtn) {
        markReadBtn.addEventListener('click', () => {
            if (notifBadge) {
                notifBadge.remove();
            }
            const sidebarBadge = document.getElementById('sidebar-notif-badge');
            if (sidebarBadge) {
                sidebarBadge.remove();
            }
            const countBadge = document.getElementById('notif-header-count');
            if (countBadge) {
                countBadge.textContent = '0 unread';
                countBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500';
            }
            markReadBtn.textContent = 'Read';
            markReadBtn.classList.add('opacity-50', 'pointer-events-none');
            // Dim items
            document.querySelectorAll('.notif-item').forEach(item => {
                item.classList.add('opacity-60');
            });
            localStorage.setItem('baistock_notifs_read', 'true');
        });
    }

    // Filter tabs for notifications
    window.filterNotifs = function(type) {
        const tabs = document.querySelectorAll('.notif-tab');
        tabs.forEach(tab => {
            if (tab.dataset.target === type) {
                tab.className = 'notif-tab flex-1 py-1 rounded-lg font-bold bg-white text-purple-700 shadow-xs';
            } else {
                tab.className = 'notif-tab flex-1 py-1 rounded-lg font-medium text-slate-500 hover:text-slate-800';
            }
        });

        const items = document.querySelectorAll('.notif-item');
        items.forEach(item => {
            if (type === 'all' || item.dataset.type === type) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    };

    const userBtn = document.getElementById('user-menu-btn');
    const userPopup = document.getElementById('user-menu-popup');
    if (userBtn && userPopup) {
        userBtn.addEventListener('click', (e) => {
            e.stopPropagation();
            userPopup.classList.toggle('hidden');
        });
    }

    document.addEventListener('click', () => {
        if (notifPopup) notifPopup.classList.add('hidden');
        if (userPopup) userPopup.classList.add('hidden');
    });
</script>
{% endblock %}
